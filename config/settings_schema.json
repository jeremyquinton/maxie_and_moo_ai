[
  {
    "name": "theme_info",
    "theme_name": "Maxie and Moo",
    "theme_version": "0.1.0",
    "theme_author": "Shopify",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "montserrat_n4",
        "label": "t:general.primary"
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "90rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "110rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 20
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "color_scheme_group",
        "id": "color_schemes",
        "definition": [
          { "type": "color", "id": "background", "label": "t:labels.background", "default": "#FFFFFF" },
          { "type": "color_background", "id": "background_gradient", "label": "t:labels.background_gradient" },
          { "type": "color", "id": "text", "label": "t:labels.foreground", "default": "#333333" },
          { "type": "color", "id": "link", "label": "t:labels.link_color", "default": "#333333" },
          { "type": "color", "id": "button", "label": "t:labels.button_color", "default": "#333333" },
          { "type": "color", "id": "button_label", "label": "t:labels.button_text_color", "default": "#FFFFFF" }
        ],
        "role": {
          "background": { "solid": "background", "gradient": "background_gradient" },
          "text": "text",
          "links": "link",
          "icons": "text",
          "primary_button": "button",
          "on_primary_button": "button_label",
          "primary_button_border": "button",
          "secondary_button": "background",
          "on_secondary_button": "link",
          "secondary_button_border": "link"
        }
      },
      {
        "type": "color",
        "id": "primary_button_color",
        "default": "#333333",
        "label": "t:labels.primary_button_color"
      },
      {
        "type": "color",
        "id": "primary_button_text_color",
        "default": "#FFFFFF",
        "label": "t:labels.primary_button_text_color"
      },
      {
        "type": "color",
        "id": "background_color",
        "default": "#FFFFFF",
        "label": "t:labels.background"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#333333",
        "label": "t:labels.foreground"
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 4
      }
    ]
  }
]
