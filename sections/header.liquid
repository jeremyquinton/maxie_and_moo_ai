<header class="site-header-nav full-width" data-site-header-nav data-sticky-threshold="{{ section.settings.sticky_threshold }}">
  <button
    class="header__menu-toggle"
    type="button"
    aria-label="{{ 'sections.header.open_menu' | t | escape }}"
    aria-expanded="false"
    aria-controls="MobileMenu-{{ section.id }}"
    data-menu-toggle
    data-open-label="{{ 'sections.header.open_menu' | t | escape }}"
    data-close-label="{{ 'sections.header.close_menu' | t | escape }}"
    hidden
  >
    <span class="header__menu-icon" aria-hidden="true"><span></span><span></span><span></span></span>
  </button>

  <nav class="header__menu" id="PrimaryMenu-{{ section.id }}" aria-label="{{ 'sections.header.navigation' | t | escape }}" data-primary-menu>
    {% for link in section.settings.menu.links %}
      {% if link.links != blank %}
        <details class="header__menu-item" data-menu-dropdown>
          <summary class="header__menu-trigger">
            {{ link.title | escape }}
            <span class="header__menu-chevron" aria-hidden="true"></span>
          </summary>
          <div class="header__submenu">
            <a class="header__submenu-all" href="{{ link.url }}">{{ 'sections.header.shop_all' | t: title: link.title | escape }}</a>
            <ul class="header__submenu-list">
              {% for childlink in link.links %}
                <li>
                  {% if childlink.links != blank %}
                    <div class="header__submenu-group">
                      <a class="header__submenu-trigger" href="{{ childlink.url }}">
                        {{ childlink.title | escape }}
                      </a>
                      <ul class="header__submenu-list header__submenu-list--nested">
                        {% for grandchildlink in childlink.links %}
                          <li><a href="{{ grandchildlink.url }}">{{ grandchildlink.title | escape }}</a></li>
                        {% endfor %}
                      </ul>
                    </div>
                  {% else %}
                    <a href="{{ childlink.url }}">{{ childlink.title | escape }}</a>
                  {% endif %}
                </li>
              {% endfor %}
            </ul>
          </div>
        </details>
      {% else %}
        <a href="{{ link.url }}">{{ link.title | escape }}</a>
      {% endif %}
    {% endfor %}
  </nav>

  <div class="header__icons">
    {% if shop.customer_accounts_enabled %}
      <shopify-account menu="{{ section.settings.customer_account_menu }}">
        {{ 'icon-account.svg' | inline_asset_content }}
      </shopify-account>
    {% endif %}

    <a href="{{ routes.cart_url }}" data-cart-drawer-open aria-label="{{ 'cart.title' | t | escape }}">
      <sup data-cart-count{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</sup>
      {{ 'icon-cart.svg' | inline_asset_content }}
    </a>
  </div>

  <div class="header__mobile-drawer" id="MobileMenu-{{ section.id }}" data-mobile-drawer hidden>
    <button class="header__mobile-scrim" type="button" data-drawer-close aria-label="{{ 'sections.header.close_menu' | t | escape }}"></button>
    <div class="header__mobile-panel" role="dialog" aria-modal="true" aria-label="{{ 'sections.header.navigation' | t | escape }}">
      <div class="header__mobile-panel-header">
        <button class="header__mobile-back" type="button" data-menu-back hidden>
          <span aria-hidden="true">&#8592;</span>
          {{ 'sections.header.back' | t | escape }}
        </button>
        <span class="header__mobile-title" data-menu-title>{{ 'sections.header.menu' | t | escape }}</span>
        <button class="header__mobile-close" type="button" data-drawer-close aria-label="{{ 'sections.header.close_menu' | t | escape }}">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>

      <nav class="header__mobile-navigation" aria-label="{{ 'sections.header.navigation' | t | escape }}">
        <ul class="header__mobile-list" data-menu-root aria-hidden="false">
          {% for link in section.settings.menu.links %}
            <li class="header__mobile-item">
              {% if link.links != blank %}
                <button
                  class="header__mobile-open"
                  type="button"
                  aria-label="{{ 'sections.header.show_links' | t: title: link.title | escape }}"
                  aria-expanded="false"
                  aria-controls="MobileMenuPanel-{{ section.id }}-{{ forloop.index }}"
                  data-menu-open
                  data-panel-id="MobileMenuPanel-{{ section.id }}-{{ forloop.index }}"
                  data-panel-title="{{ link.title | escape }}"
                >
                  <span>{{ link.title | escape }}</span>
                  <span class="header__mobile-chevron" aria-hidden="true"></span>
                </button>
              {% else %}
                <a href="{{ link.url }}">{{ link.title | escape }}</a>
              {% endif %}
            </li>
          {% endfor %}
        </ul>

        {% for link in section.settings.menu.links %}
          {% if link.links != blank %}
            <div class="header__mobile-list" id="MobileMenuPanel-{{ section.id }}-{{ forloop.index }}" data-menu-panel data-panel-title="{{ link.title | escape }}" aria-hidden="true" inert>
              <a class="header__mobile-shop-all" href="{{ link.url }}">{{ 'sections.header.shop_all' | t: title: link.title | escape }}</a>
              {% for childlink in link.links %}
                {% if childlink.links != blank %}
                  <details class="header__mobile-submenu">
                    <summary>
                      {{ childlink.title | escape }}
                      <span class="header__mobile-chevron" aria-hidden="true"></span>
                    </summary>
                    <ul>
                      <li><a href="{{ childlink.url }}">{{ 'sections.header.shop_all' | t: title: childlink.title | escape }}</a></li>
                      {% for grandchildlink in childlink.links %}
                        <li><a href="{{ grandchildlink.url }}">{{ grandchildlink.title | escape }}</a></li>
                      {% endfor %}
                    </ul>
                  </details>
                {% else %}
                  <a class="header__mobile-link" href="{{ childlink.url }}">{{ childlink.title | escape }}</a>
                {% endif %}
              {% endfor %}
            </div>
          {% endif %}
        {% endfor %}
      </nav>
    </div>
  </div>
</header>

{% stylesheet %}
  .site-header-shell {
    position: relative;
    z-index: 20;
  }

  .site-header-shell--solid {
    padding-bottom: 68px;
  }

  .site-header-nav {
    position: relative;
    height: 5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .site-header-nav a {
    position: relative;
    text-decoration: none;
    color: inherit;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .site-header-nav a sup {
    position: absolute;
    left: 100%;
    overflow: hidden;
    max-width: var(--page-margin);
  }

  .site-header-nav svg {
    width: 2rem;
  }

  .site-header-nav .header__menu,
  .site-header-nav .header__icons {
    display: flex;
    gap: 1rem;
  }

  .site-header-nav .header__menu-toggle {
    display: none;
    width: 40px;
    height: 40px;
    flex: 0 0 40px;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }

  .header__menu-item,
  .header__submenu-group {
    position: relative;
  }

  .header__menu-trigger,
  .header__submenu-trigger {
    display: flex;
    min-height: 40px;
    align-items: center;
    gap: 8px;
    color: inherit;
    cursor: pointer;
    list-style: none;
  }

  .header__menu-trigger::-webkit-details-marker,
  .header__submenu-trigger::-webkit-details-marker {
    display: none;
  }

  .header__menu-chevron {
    width: 7px;
    height: 7px;
    flex: 0 0 7px;
    border-right: 1px solid currentColor;
    border-bottom: 1px solid currentColor;
    transform: rotate(45deg) translateY(-2px);
    transition: transform 160ms ease;
  }

  details[open] > .header__menu-trigger .header__menu-chevron,
  details[open] > .header__submenu-trigger .header__menu-chevron {
    transform: rotate(225deg) translate(-1px, -1px);
  }

  .header__submenu {
    position: absolute;
    top: 100%;
    left: -16px;
    z-index: 45;
    width: max-content;
    min-width: 220px;
    max-width: min(360px, calc(100vw - 32px));
    padding: 10px 16px 14px;
    background: #fff;
    color: #20211e;
    box-shadow: 0 8px 18px rgb(0 0 0 / 14%);
  }

  .header__submenu-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .header__submenu-all,
  .header__submenu-list a,
  .header__submenu-trigger {
    min-height: 42px;
    justify-content: flex-start;
    padding: 8px 0;
    border-bottom: 1px solid rgb(32 33 30 / 12%);
    font-size: var(--font-size-base, 14px);
    text-decoration: none;
  }

  .header__submenu-all {
    font-weight: 600;
  }

  .header__submenu-group > .header__submenu-list--nested {
    padding-left: 12px;
  }

  @media (min-width: 750px) {
    .site-header-nav .header__menu {
      align-self: stretch;
      align-items: stretch;
    }

    .header__menu-item {
      position: static;
    }

    .header__menu-trigger {
      height: 100%;
    }

    .header__submenu {
      right: 0;
      left: 0;
      width: auto;
      min-width: 0;
      max-width: none;
      max-height: min(70vh, calc(100dvh - 160px));
      overflow-y: auto;
      padding: 28px max(var(--page-margin), calc((100% - var(--page-width)) / 2)) 36px;
      border-top: 1px solid rgb(32 33 30 / 10%);
      box-shadow: 0 12px 20px rgb(0 0 0 / 10%);
    }

    .header__submenu > .header__submenu-list {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
      gap: 0;
    }

    .header__submenu-all {
      width: fit-content;
      margin-bottom: 16px;
    }

    .header__submenu-list a {
      border: 0;
      overflow-wrap: anywhere;
    }

    .header__submenu-trigger {
      font-weight: 600;
    }

    .header__submenu-group > .header__submenu-list--nested {
      padding-left: 0;
    }

    .header__submenu a:hover,
    .header__submenu a:focus-visible {
      text-decoration: underline;
      text-underline-offset: 3px;
    }
  }

  .header__menu-icon {
    display: flex;
    width: 22px;
    flex-direction: column;
    gap: 5px;
  }

  .header__menu-icon span {
    display: block;
    width: 100%;
    height: 1px;
    background: currentColor;
    transition: transform 160ms ease, opacity 160ms ease;
  }

  .site-header-nav.is-menu-open .header__menu-icon span:first-child {
    transform: translateY(6px) rotate(45deg);
  }

  .site-header-nav.is-menu-open .header__menu-icon span:nth-child(2) {
    opacity: 0;
  }

  .site-header-nav.is-menu-open .header__menu-icon span:last-child {
    transform: translateY(-6px) rotate(-45deg);
  }

  .site-header-shell--overlay .site-header-nav,
  .site-header-shell--solid .site-header-nav {
    position: absolute;
    top: 100%;
    right: 0;
    left: 0;
    z-index: 41;
    height: 88px;
    padding-inline: 32px;
    padding-inline-start: 56px;
    background: transparent;
    color: #fff;
    transition: background-color 180ms ease, color 180ms ease, box-shadow 180ms ease;
  }

  .site-header-shell--solid .site-header-nav {
    height: 68px;
    background: #fff;
    color: #20211e;
  }

  .site-header-shell--overlay.is-sticky .site-header-nav,
  .site-header-shell--solid.is-sticky .site-header-nav {
    position: fixed;
    top: 0;
    height: 68px;
    background: #fff;
    color: #20211e;
    box-shadow: 0 2px 12px rgb(0 0 0 / 10%);
  }

  @media (max-width: 749px) {
    .site-header-shell--solid {
      padding-bottom: 58px;
    }

    .site-header-shell--overlay .site-header-nav,
    .site-header-shell--solid .site-header-nav {
      top: 100%;
      height: 58px;
      padding-inline: 12px;
      transition: background-color 180ms ease, color 180ms ease, box-shadow 180ms ease, z-index 0s 300ms;
    }

    :is(.site-header-shell--overlay, .site-header-shell--solid) .site-header-nav:has(.header__mobile-drawer:not([hidden])) {
      z-index: 43;
      transition-delay: 0s;
    }

    .site-header-nav.has-mobile-menu .header__menu-toggle {
      display: flex;
    }

    .site-header-nav.has-mobile-menu .header__menu {
      display: none;
    }

    .header__mobile-drawer {
      position: fixed;
      z-index: 100;
      inset: 0;
      color: #20211e;
      transition: display 300ms allow-discrete;
    }

    .header__mobile-drawer[hidden],
    .header__mobile-back[hidden] {
      display: none !important;
    }

    .header__mobile-scrim {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      border: 0;
      background: rgb(0 0 0 / 28%);
      opacity: 0;
      transition: opacity 300ms ease;
    }

    .header__mobile-panel {
      position: absolute;
      inset: 0 auto 0 0;
      display: flex;
      flex-direction: column;
      width: min(100%, 420px);
      height: 100vh;
      height: 100dvh;
      overflow-y: auto;
      background: #fff;
      transform: translateX(-100%);
      transition: transform 300ms ease;
      overscroll-behavior: contain;
    }

    .site-header-nav.is-menu-open .header__mobile-panel {
      transform: translateX(0);
    }

    .site-header-nav.is-menu-open .header__mobile-scrim {
      opacity: 1;
    }

    .header__mobile-panel-header {
      position: sticky;
      top: 0;
      z-index: 1;
      display: grid;
      min-height: 64px;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      padding: 8px 18px;
      border-bottom: 1px solid rgb(32 33 30 / 12%);
      background: #fff;
    }

    .header__mobile-title {
      grid-column: 2;
      font-size: var(--font-size-base, 14px);
      font-weight: 600;
      text-align: center;
      text-transform: uppercase;
    }

    .header__mobile-back,
    .header__mobile-close {
      display: inline-flex;
      min-width: 40px;
      min-height: 40px;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 0;
      border: 0;
      background: transparent;
      color: inherit;
      cursor: pointer;
      font: inherit;
    }

    .header__mobile-back {
      grid-column: 1;
      justify-self: start;
      font-size: var(--font-size-base, 14px);
    }

    .header__mobile-close {
      grid-column: 3;
      justify-self: end;
      font-size: 26px;
      line-height: 1;
    }

    .header__mobile-navigation {
      position: relative;
      min-height: 0;
      flex: 1 1 auto;
      overflow: hidden;
    }

    .header__mobile-list {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      margin: 0;
      padding: 8px 20px 32px;
      overflow-y: auto;
      list-style: none;
      transition: transform 340ms cubic-bezier(0.22, 0.68, 0, 1);
      will-change: transform;
    }

    .header__mobile-list[data-menu-root] {
      transform: translateX(0);
    }

    .header__mobile-list[data-menu-panel] {
      transform: translateX(100%);
    }

    .header__mobile-drawer[data-menu-submenu-open] [data-menu-root] {
      transform: translateX(-100%);
    }

    .header__mobile-drawer[data-menu-submenu-open] [data-menu-panel].is-active {
      transform: translateX(0);
    }

    .header__mobile-item {
      display: flex;
      min-height: 60px;
      align-items: center;
    }

    .header__mobile-item > a,
    .header__mobile-open {
      min-width: 0;
      min-height: 58px;
      flex: 1 1 auto;
      justify-content: flex-start;
      font-size: var(--font-size-base, 14px);
      font-weight: 600;
      text-transform: uppercase;
    }

    .header__mobile-open {
      display: flex;
      width: 100%;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding: 0;
      border: 0;
      background: transparent;
      color: inherit;
      text-align: left;
      cursor: pointer;
    }

    .header__mobile-chevron {
      width: 9px;
      height: 9px;
      margin-inline-start: auto;
      border-top: 1px solid currentColor;
      border-right: 1px solid currentColor;
      transform: rotate(45deg);
    }

    .header__mobile-navigation a,
    .header__mobile-shop-all,
    .header__mobile-link,
    .header__mobile-submenu > summary,
    .header__mobile-submenu li a {
      display: flex;
      min-height: 54px;
      align-items: center;
      justify-content: flex-start;
      color: inherit;
      font-size: var(--font-size-base, 14px);
      text-align: left;
      text-decoration: none;
    }

    .header__mobile-shop-all {
      font-weight: 600;
      text-transform: uppercase;
    }

    .header__mobile-submenu > summary {
      cursor: pointer;
      list-style: none;
    }

    .header__mobile-submenu > summary::-webkit-details-marker {
      display: none;
    }

    .header__mobile-submenu ul {
      margin: 0;
      padding: 0 0 0 14px;
      list-style: none;
    }

    .header__mobile-submenu li a {
      min-height: 46px;
      font-size: var(--font-size-base, 14px);
    }

    .header__mobile-back:focus-visible,
    .header__mobile-close:focus-visible,
    .header__mobile-open:focus-visible {
      outline: 2px solid currentColor;
      outline-offset: 2px;
    }

    .site-header-nav.has-mobile-menu.is-menu-open .header__menu-toggle {
      z-index: 1;
    }

    .site-header-nav.has-mobile-menu .header__menu-item,
    .site-header-nav.has-mobile-menu .header__menu-trigger,
    .site-header-nav.has-mobile-menu .header__submenu {
      display: none;
    }

    .site-header-shell--overlay .site-header-nav .header__icons,
    .site-header-shell--solid .site-header-nav .header__icons {
      flex: 0 0 auto;
      gap: 12px;
    }

    .site-header-shell--overlay .site-header-nav .header__icons svg,
    .site-header-shell--solid .site-header-nav .header__icons svg {
      width: 1.5rem;
    }

    .site-header-shell--overlay.is-sticky .site-header-nav,
    .site-header-shell--solid.is-sticky .site-header-nav {
      top: 0;
      height: 58px;
      align-items: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .header__menu-icon span,
    .site-header-nav,
    .header__mobile-drawer,
    .header__mobile-scrim,
    .header__mobile-panel,
    .header__mobile-list {
      transition: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  (() => {
    const headerSelector = '[data-site-header-nav]';
    const controllers = new WeakMap();
    const menuControllers = new WeakMap();

    const eachHeader = (root, callback) => {
      if (root.matches?.(headerSelector)) callback(root);
      root.querySelectorAll?.(headerSelector).forEach(callback);
    };

    const initializeMenu = (header) => {
      const toggle = header.querySelector('[data-menu-toggle]');
      const menu = header.querySelector('[data-primary-menu]');
      const drawer = header.querySelector('[data-mobile-drawer]');
      if (!toggle || !menu || !drawer || menuControllers.has(header)) return;

      const controller = new AbortController();
      const mobilePanel = drawer.querySelector('.header__mobile-panel');
      const rootView = drawer.querySelector('[data-menu-root]');
      const menuTitle = drawer.querySelector('[data-menu-title]');
      const backButton = drawer.querySelector('[data-menu-back]');
      const panels = Array.from(drawer.querySelectorAll('[data-menu-panel]'));
      const defaultTitle = menuTitle.textContent;
      let previousDocumentOverflow = '';
      let activeTrigger = null;

      const showRootView = (returnFocus = false) => {
        drawer.removeAttribute('data-menu-submenu-open');
        rootView.inert = false;
        rootView.setAttribute('aria-hidden', 'false');
        rootView.querySelectorAll('[data-menu-open]').forEach((button) => {
          button.setAttribute('aria-expanded', 'false');
        });
        panels.forEach((panel) => {
          panel.classList.remove('is-active');
          panel.inert = true;
          panel.setAttribute('aria-hidden', 'true');
        });
        backButton.hidden = true;
        menuTitle.textContent = defaultTitle;
        if (returnFocus && activeTrigger) activeTrigger.focus({ preventScroll: true });
        activeTrigger = null;
      };

      const closeMenu = (returnFocus = false) => {
        const wasOpen = !drawer.hidden;
        header.classList.remove('is-menu-open');
        toggle.setAttribute('aria-expanded', 'false');
        toggle.setAttribute('aria-label', toggle.dataset.openLabel);
        drawer.hidden = true;
        showRootView();
        if (wasOpen) document.documentElement.style.overflow = previousDocumentOverflow;
        if (returnFocus) toggle.focus();
      };

      const openMenu = () => {
        previousDocumentOverflow = document.documentElement.style.overflow;
        document.documentElement.style.overflow = 'hidden';
        drawer.hidden = false;
        mobilePanel.getBoundingClientRect();
        header.classList.add('is-menu-open');
        toggle.setAttribute('aria-expanded', 'true');
        toggle.setAttribute('aria-label', toggle.dataset.closeLabel);
        drawer.querySelector('.header__mobile-close').focus();
      };

      const closeDropdowns = () => {
        header.querySelectorAll('[data-menu-dropdown][open]').forEach((dropdown) => {
          dropdown.open = false;
        });
      };

      const desktopDropdowns = menu.querySelectorAll('[data-menu-dropdown]');
      const supportsHover = () => window.matchMedia('(hover: hover) and (pointer: fine)').matches;
      const openDropdown = (dropdown) => {
        desktopDropdowns.forEach((otherDropdown) => {
          otherDropdown.open = otherDropdown === dropdown;
        });
      };

      desktopDropdowns.forEach((dropdown) => {
        const summary = dropdown.querySelector(':scope > summary');
        dropdown.addEventListener('pointerenter', () => {
          if (supportsHover()) openDropdown(dropdown);
        }, { signal: controller.signal });
        dropdown.addEventListener('pointerleave', () => {
          if (supportsHover()) dropdown.open = false;
        }, { signal: controller.signal });
        dropdown.addEventListener('focusin', () => {
          if (window.matchMedia('(min-width: 750px)').matches) openDropdown(dropdown);
        }, { signal: controller.signal });
        dropdown.addEventListener('focusout', (event) => {
          if (window.matchMedia('(min-width: 750px)').matches && !dropdown.contains(event.relatedTarget)) {
            dropdown.open = false;
          }
        }, { signal: controller.signal });
        summary.addEventListener('click', (event) => {
          if (supportsHover() && event.detail > 0) {
            event.preventDefault();
            openDropdown(dropdown);
          }
        }, { signal: controller.signal });
      });

      toggle.hidden = false;
      header.classList.add('has-mobile-menu');
      toggle.addEventListener('click', () => {
        if (drawer.hidden) openMenu();
        else closeMenu();
      }, { signal: controller.signal });
      menu.addEventListener('click', (event) => {
        if (event.target.closest('a')) closeMenu();
      }, { signal: controller.signal });
      drawer.addEventListener('click', (event) => {
        if (event.target.closest('[data-drawer-close]')) {
          closeMenu();
          return;
        }

        if (event.target.closest('[data-menu-back]')) {
          showRootView(true);
          return;
        }

        const openButton = event.target.closest('[data-menu-open]');
        if (openButton) {
          const targetPanel = drawer.querySelector(`#${CSS.escape(openButton.dataset.panelId)}`);
          if (!targetPanel) return;
          activeTrigger = openButton;
          openButton.setAttribute('aria-expanded', 'true');
          drawer.setAttribute('data-menu-submenu-open', '');
          rootView.inert = true;
          rootView.setAttribute('aria-hidden', 'true');
          panels.forEach((panel) => {
            const isActive = panel === targetPanel;
            panel.classList.toggle('is-active', isActive);
            panel.inert = !isActive;
            panel.setAttribute('aria-hidden', String(!isActive));
          });
          backButton.hidden = false;
          menuTitle.textContent = openButton.dataset.panelTitle;
          targetPanel.querySelector('a')?.focus({ preventScroll: true });
          return;
        }

        if (event.target.closest('a')) closeMenu();
      }, { signal: controller.signal });
      document.addEventListener('click', (event) => {
        if (!header.contains(event.target)) {
          closeMenu();
          closeDropdowns();
        }
      }, { signal: controller.signal });
      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape') return;
        const activeDropdown = menu.querySelector('[data-menu-dropdown][open]');
        if (activeDropdown?.contains(document.activeElement)) {
          activeDropdown.querySelector(':scope > summary').focus();
        }
        closeDropdowns();
        if (!drawer.hidden) {
          if (!backButton.hidden) showRootView(true);
          else closeMenu(true);
        }
      }, { signal: controller.signal });
      menuControllers.set(header, { controller, close: closeMenu });
    };

    const initializeHeader = (header) => {
      initializeMenu(header);
      const shell = header.closest('[data-site-header-shell]');
      if (!shell || controllers.has(shell)) return;

      const threshold = Number.parseInt(header.dataset.stickyThreshold, 10);
      const scrollThreshold = Number.isFinite(threshold) ? threshold : 80;
      const controller = new AbortController();
      const update = () => shell.classList.toggle('is-sticky', window.scrollY > scrollThreshold);

      window.addEventListener('scroll', update, { passive: true, signal: controller.signal });
      window.addEventListener('resize', update, { passive: true, signal: controller.signal });
      controllers.set(shell, controller);
      update();
    };

    const destroyHeader = (header) => {
      const menuController = menuControllers.get(header);
      if (menuController) {
        menuController.close();
        menuController.controller.abort();
      }
      menuControllers.delete(header);
      header.classList.remove('has-mobile-menu', 'is-menu-open');

      const shell = header.closest('[data-site-header-shell]');
      const controller = shell && controllers.get(shell);
      if (!controller) return;

      controller.abort();
      shell.classList.remove('is-sticky');
      controllers.delete(shell);
    };

    eachHeader(document, initializeHeader);
    document.addEventListener('shopify:section:load', (event) => eachHeader(event.target, initializeHeader));
    document.addEventListener('shopify:section:unload', (event) => eachHeader(event.target, destroyHeader));
  })();
{% endjavascript %}

{% render 'section-color-scheme', section: section %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    { "type": "checkbox", "id": "use_color_scheme", "label": "t:labels.use_color_scheme", "default": false },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:labels.color_scheme", "default": "scheme-1", "visible_if": "{{ section.settings.use_color_scheme }}" },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu"
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "t:labels.customer_account_menu",
      "default": "customer-account-main-menu"
    },
    {
      "type": "range",
      "id": "sticky_threshold",
      "label": "t:sections.header.settings.sticky_threshold.label",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 80
    }
  ]
}
