{% comment %}
  This section is used in the collection template to render collection page
  listing all products within a collection.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/collection
{% endcomment %}

<header
  class="collection-hero full-width{% if collection.image == blank or section.settings.show_collection_image == false %} collection-hero--without-image{% endif %} collection-hero--{{ section.settings.content_alignment }}"
  style="--collection-hero-height: {{ section.settings.hero_height }}px; --collection-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }}"
>
  {%- if section.settings.show_collection_image and collection.image != blank -%}
    <div class="collection-hero__media">
      {{ collection.image | image_url: width: 2400 | image_tag: class: 'collection-hero__image', widths: '750, 1100, 1500, 1900, 2400', sizes: '100vw', loading: 'eager', alt: collection.image.alt | default: collection.title }}
    </div>
  {%- endif -%}
  <div class="collection-hero__content">
    <h1>{{ collection.title | escape }}</h1>
    {%- if section.settings.show_description and collection.description != blank -%}
      <div class="collection-hero__description rte">{{ collection.description }}</div>
    {%- endif -%}
  </div>
</header>

<div class="collection-products full-width">
  {% paginate collection.products by 20 %}
    {% for product in collection.products %}
      {% render 'product-card', product: product, heading_tag: 'h2', show_from_price: true %}
    {% endfor %}

    {% if paginate.pages > 1 %}
      <div class="collection-products__pagination">{{ paginate | default_pagination }}</div>
    {% endif %}
  {% endpaginate %}
</div>

<script src="{{ 'collection-color-cards.js' | asset_url }}" defer="defer"></script>

{% stylesheet %}
  .collection-hero {
    position: relative;
    display: flex;
    min-height: var(--collection-hero-height);
    align-items: center;
    overflow: hidden;
    padding: clamp(28px, 6vw, 84px);
    background: #e8e8e1;
    color: #20211e;
  }

  .collection-hero:not(.collection-hero--without-image) {
    color: #fff;
  }

  .collection-hero__media,
  .collection-hero__media::after {
    position: absolute;
    inset: 0;
  }

  .collection-hero__media::after {
    background: rgb(0 0 0 / var(--collection-overlay-opacity));
    content: '';
  }

  .collection-hero__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .collection-hero__content {
    position: relative;
    z-index: 1;
    width: min(100%, 760px);
  }

  .collection-hero--center .collection-hero__content {
    margin-inline: auto;
    text-align: center;
  }

  .collection-hero--right .collection-hero__content {
    margin-inline-start: auto;
    text-align: right;
  }

  .collection-hero h1 {
    margin: 0;
    font-family: var(--font-primary--family);
    font-size: clamp(32px, 5vw, 64px);
    font-weight: 600;
    line-height: 1.05;
  }

  .collection-hero__description {
    max-width: 620px;
    margin-block-start: 14px;
    font-size: var(--font-size-base, 14px);
    line-height: 1.65;
  }

  .collection-hero--center .collection-hero__description {
    margin-inline: auto;
  }

  .collection-hero--right .collection-hero__description {
    margin-inline-start: auto;
  }

  .collection-products {
    display: grid;
    width: 100%;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 28px 16px;
    padding: 48px var(--page-margin, 24px) 64px;
  }

  .collection-products__pagination {
    display: flex;
    grid-column: 1 / -1;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
  }

  @media (max-width: 700px) {
    .collection-hero {
      min-height: min(var(--collection-hero-height), 420px);
      padding: 28px 20px;
    }

    .collection-hero h1 {
      font-size: 34px;
    }

    .collection-hero__description {
      font-size: var(--font-size-base, 14px);
    }

    .collection-products {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 22px 10px;
      padding-block: 36px 48px;
    }

  }

{% endstylesheet %}

{% render 'section-color-scheme', section: section %}

{% render 'section-spacing', section: section %}

{% schema %}
{
  "name": "t:general.collection",
  "settings": [
    {
      "type": "range",
      "id": "section_space_above",
      "label": "t:labels.section_space_above",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_space_below",
      "label": "t:labels.section_space_below",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    { "type": "checkbox", "id": "use_color_scheme", "label": "t:labels.use_color_scheme", "default": false },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:labels.color_scheme", "default": "scheme-1", "visible_if": "{{ section.settings.use_color_scheme }}" },
    {
      "type": "checkbox",
      "id": "show_collection_image",
      "label": "t:collections.hero.show_image",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "t:collections.hero.show_description",
      "default": true
    },
    {
      "type": "range",
      "id": "hero_height",
      "label": "t:collections.hero.height",
      "min": 280,
      "max": 620,
      "step": 20,
      "unit": "px",
      "default": 460
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "t:collections.hero.overlay",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 25
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "t:collections.hero.alignment",
      "options": [
        { "value": "left", "label": "t:options.alignment.left" },
        { "value": "center", "label": "t:options.alignment.center" },
        { "value": "right", "label": "t:options.alignment.right" }
      ],
      "default": "left"
    }
  ]
}
{% endschema %}
