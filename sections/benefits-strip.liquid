<section
  class="benefits-strip full-width"
  style="--benefits-strip-background: {{ section.settings.background_color }}; --benefits-strip-foreground: {{ section.settings.text_color }}"
>
  <ul class="benefits-strip__grid">
    {%- for block in section.blocks -%}
      <li class="benefits-strip__item" {{ block.shopify_attributes }}>
        <div class="benefits-strip__image-wrap">
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 320 | image_tag: class: 'benefits-strip__image', widths: '96, 128, 192, 256, 320', sizes: '(min-width: 750px) 112px, 88px', loading: 'lazy', alt: '' }}
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'benefits-strip__image benefits-strip__placeholder' }}
          {%- endif -%}
        </div>
        {%- if block.settings.heading != blank -%}
          <h2 class="benefits-strip__heading">{{ block.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if block.settings.description != blank -%}
          <p class="benefits-strip__description">{{ block.settings.description | escape }}</p>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</section>

{% stylesheet %}
  .benefits-strip {
    width: 100%;
    padding: 28px 24px;
    background: var(--benefits-strip-background);
    color: var(--benefits-strip-foreground);
  }

  .benefits-strip__grid {
    display: grid;
    width: min(100%, 1080px);
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }

  .benefits-strip__item {
    display: flex;
    min-width: 0;
    align-items: center;
    flex-direction: column;
    text-align: center;
  }

  .benefits-strip__image-wrap {
    display: grid;
    width: 112px;
    height: 112px;
    place-items: center;
    margin-block-end: 8px;
  }

  .benefits-strip__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .benefits-strip__heading {
    max-width: 100%;
    margin: 0;
    color: inherit;
    font-family: var(--font-primary--family);
    font-size: 16px;
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.25;
    overflow-wrap: anywhere;
  }

  .benefits-strip__description {
    max-width: 28ch;
    margin: 6px 0 0;
    color: inherit;
    font-size: var(--font-size-base, 14px);
    letter-spacing: 0;
    line-height: 1.4;
    opacity: 0.88;
    overflow-wrap: anywhere;
  }

  .benefits-strip__placeholder {
    opacity: 0.3;
  }

  @media (max-width: 749px) {
    .benefits-strip {
      padding: 24px 20px;
    }

    .benefits-strip__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 28px 16px;
    }

    .benefits-strip__image-wrap {
      width: 88px;
      height: 88px;
      margin-block-end: 8px;
    }
  }
{% endstylesheet %}

{% render 'section-spacing', section: section %}

{% schema %}
{
  "name": "t:general.benefits_strip",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "benefit",
      "name": "t:sections.benefits_strip.blocks.benefit.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.benefits_strip.blocks.benefit.settings.image.label"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.benefits_strip.blocks.benefit.settings.heading.label",
          "default": "Easy to clean"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "t:sections.benefits_strip.blocks.benefit.settings.description.label",
          "default": "100% waterproof, wipeable"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "t:sections.benefits_strip.settings.background_color.label",
      "default": "#577397"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:sections.benefits_strip.settings.text_color.label",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "section_space_above",
      "label": "t:labels.section_space_above",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_space_below",
      "label": "t:labels.section_space_below",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:general.benefits_strip",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "heading": "Easy to clean",
            "description": "100% waterproof, wipeable"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "heading": "Non toxic",
            "description": "BPA-free and phthalate-free"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "heading": "Interlocking",
            "description": "Seamless and expandable"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "heading": "Extra thick",
            "description": "Soft padded EVA foam"
          }
        }
      ]
    }
  ]
}
{% endschema %}