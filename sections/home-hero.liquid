{% liquid
  assign hero_heading = section.settings.heading
  assign hero_image = section.settings.desktop_image | default: section.settings.mobile_image
  assign hero_slide_count = 0
  assign has_legacy_image = false

  if section.settings.desktop_image != blank or section.settings.mobile_image != blank
    assign has_legacy_image = true
  endif

  for block in section.blocks
    if block.settings.desktop_image != blank or block.settings.mobile_image != blank
      assign hero_slide_count = hero_slide_count | plus: 1
    endif
  endfor
%}

<section
  class="home-hero full-width home-hero--{{ section.settings.text_alignment }} home-hero--{{ section.settings.vertical_alignment }}{% if hero_slide_count > 1 %} home-hero--slideshow{% endif %}{% if hero_slide_count == 0 and has_legacy_image == false %} home-hero--without-image{% endif %}"
  style="--home-hero-desktop-height: {{ section.settings.desktop_height }}px; --home-hero-mobile-height: {{ section.settings.mobile_height }}px; --home-hero-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }}; --home-hero-overlay-color: {{ section.settings.overlay_color }}; --home-hero-text-color: {{ section.settings.text_color }}{% if section.settings.customize_button_colors %}; --button-custom-color: {{ section.settings.button_color }}; --button-custom-text-color: {{ section.settings.button_text_color }}{% endif %}"
>
  {%- if hero_slide_count > 0 -%}
    <div
      class="home-hero__slides"
      aria-label="{{ 'sections.home_hero.slideshow' | t | escape }}"
      data-home-hero-slideshow
      data-rotation-interval="{{ section.settings.rotation_interval | times: 1000 }}"
      data-auto-rotate="{{ section.settings.auto_rotate }}"
    >
      {%- assign rendered_slide_count = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.settings.desktop_image != blank or block.settings.mobile_image != blank -%}
          {%- assign rendered_slide_count = rendered_slide_count | plus: 1 -%}
          {%- assign slide_image = block.settings.desktop_image | default: block.settings.mobile_image -%}
          {%- assign slide_loading = 'lazy' -%}
          {%- if rendered_slide_count == 1 -%}
            {%- assign slide_loading = 'eager' -%}
          {%- endif -%}
          <div class="home-hero__slide{% if rendered_slide_count == 1 %} is-active{% endif %}" data-home-hero-slide aria-hidden="{% if rendered_slide_count == 1 %}false{% else %}true{% endif %}" {{ block.shopify_attributes }}>
            <picture class="home-hero__media">
              {%- if block.settings.mobile_image != blank -%}
                <source
                  media="(max-width: 749px)"
                  srcset="{{ block.settings.mobile_image | image_url: width: 1200 }}"
                >
              {%- endif -%}
              {{ slide_image | image_url: width: 2400 | image_tag: class: 'home-hero__image', widths: '750, 1100, 1500, 1900, 2400', sizes: '100vw', loading: slide_loading, alt: hero_heading }}
            </picture>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- else -%}
    <picture class="home-hero__media">
      {%- if section.settings.mobile_image != blank -%}
        <source
          media="(max-width: 749px)"
          srcset="{{ section.settings.mobile_image | image_url: width: 1200 }}"
        >
      {%- endif -%}
      {%- if hero_image != blank -%}
        {{ hero_image | image_url: width: 2400 | image_tag: class: 'home-hero__image', widths: '750, 1100, 1500, 1900, 2400', sizes: '100vw', loading: 'eager', alt: hero_heading }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'home-hero__image home-hero__placeholder' }}
      {%- endif -%}
    </picture>
  {%- endif -%}
  <span class="home-hero__overlay" aria-hidden="true"></span>

  <div class="home-hero__content">
    {%- if section.settings.eyebrow != blank -%}
      <p class="home-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if hero_heading != blank -%}
      <h1>{{ hero_heading | escape }}</h1>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="home-hero__subheading">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}
    {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
      <a class="home-hero__button theme-button--{{ section.settings.button_style | default: 'primary' }}" href="{{ section.settings.button_link }}">
        {{ section.settings.button_label | escape }}
        <span aria-hidden="true">&#8599;</span>
      </a>
    {%- endif -%}
  </div>

  {%- if hero_slide_count > 1 -%}
    <div class="home-hero__controls" aria-label="{{ 'sections.home_hero.slideshow_controls' | t | escape }}">
      <button class="home-hero__control" type="button" aria-label="{{ 'sections.home_hero.previous_slide' | t | escape }}" data-home-hero-previous>
        <span aria-hidden="true">&#8592;</span>
      </button>
      {%- if section.settings.auto_rotate -%}
        <button
          class="home-hero__control"
          type="button"
          aria-label="{{ 'sections.home_hero.pause_rotation' | t | escape }}"
          data-home-hero-toggle
          data-pause-label="{{ 'sections.home_hero.pause_rotation' | t | escape }}"
          data-resume-label="{{ 'sections.home_hero.resume_rotation' | t | escape }}"
        >
          <span aria-hidden="true" data-home-hero-toggle-icon>II</span>
        </button>
      {%- endif -%}
      <button class="home-hero__control" type="button" aria-label="{{ 'sections.home_hero.next_slide' | t | escape }}" data-home-hero-next>
        <span aria-hidden="true">&#8594;</span>
      </button>
    </div>
  {%- endif -%}
</section>

{% stylesheet %}
  .home-hero {
    position: relative;
    display: flex;
    min-height: var(--home-hero-desktop-height);
    align-items: center;
    overflow: hidden;
    background: #e8e8e1;
    color: var(--home-hero-text-color);
  }

  .home-hero__media,
  .home-hero__overlay {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  .home-hero__slides,
  .home-hero__slide {
    position: absolute;
    inset: 0;
  }

  .home-hero__slide {
    opacity: 0;
    pointer-events: none;
    transition: opacity 600ms ease;
  }

  .home-hero__slide.is-active {
    opacity: 1;
  }

  .home-hero__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .home-hero--without-image {
    color: #20211e;
  }

  .home-hero__overlay {
    background-color: var(--home-hero-overlay-color);
    opacity: var(--home-hero-overlay-opacity);
  }

  .home-hero__content {
    position: relative;
    z-index: 1;
    width: min(100% - 48px, 1440px);
    margin-inline: auto;
    padding-block: 56px;
  }

  .home-hero--slideshow .home-hero__content {
    padding-block-end: 104px;
  }

  .home-hero__controls {
    position: absolute;
    z-index: 2;
    right: 24px;
    bottom: 24px;
    display: flex;
    gap: 8px;
  }

  .home-hero__control {
    display: grid;
    width: 44px;
    height: 44px;
    place-items: center;
    border: 1px solid currentColor;
    border-radius: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
    font: inherit;
    font-size: 18px;
    line-height: 1;
  }

  .home-hero__control:hover {
    background: rgb(255 255 255 / 18%);
  }

  .home-hero__control:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  .home-hero--center .home-hero__content {
    text-align: center;
  }

  .home-hero--right .home-hero__content {
    text-align: right;
  }

  .home-hero--top {
    align-items: flex-start;
  }

  .home-hero--bottom {
    align-items: flex-end;
  }

  .home-hero__eyebrow {
    margin-block-end: 12px;
    font-size: var(--font-size-base, 14px);
    font-weight: 600;
    text-transform: uppercase;
  }

  .home-hero h1 {
    max-width: 760px;
    margin: 0;
    font-family: var(--font-primary--family);
    font-size: 56px;
    font-weight: 600;
    line-height: 1.05;
  }

  .home-hero--center h1 {
    margin-inline: auto;
  }

  .home-hero--right h1 {
    margin-inline-start: auto;
  }

  .home-hero__subheading {
    max-width: 620px;
    margin-block-start: 16px;
    font-size: 16px;
    line-height: 1.6;
  }

  .home-hero--center .home-hero__subheading {
    margin-inline: auto;
  }

  .home-hero--right .home-hero__subheading {
    margin-inline-start: auto;
  }

  .home-hero__button {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-block-start: 24px;
    padding-inline: 16px;
    border: 1px solid currentColor;
    background: var(--section-button, var(--color-background, #fff));
    color: var(--section-button-text, var(--color-foreground, #20211e));
    font-size: var(--font-size-base, 14px);
    font-weight: 600;
    text-decoration: none;
  }

  .home-hero__button:hover {
    opacity: 0.82;
  }

  @media (max-width: 749px) {
    .home-hero {
      min-height: var(--home-hero-mobile-height);
    }

    .home-hero__content {
      width: calc(100% - 40px);
      padding-block: 32px;
    }

    .home-hero--slideshow .home-hero__content {
      padding-block-end: 96px;
    }

    .home-hero__controls {
      right: 20px;
      bottom: 20px;
    }

    .home-hero h1 {
      font-size: 36px;
    }

    .home-hero__subheading {
      margin-block-start: 12px;
      font-size: var(--font-size-base, 14px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-hero__slide {
      transition: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  (() => {
    const selector = '[data-home-hero-slideshow]';
    const instances = new WeakMap();

    const findSlideshows = (context) => {
      const slideshows = [];
      if (context.matches && context.matches(selector)) slideshows.push(context);
      if (context.querySelectorAll) slideshows.push(...context.querySelectorAll(selector));
      return slideshows;
    };

    const initialize = (slideshow) => {
      if (instances.has(slideshow)) return;

      const section = slideshow.closest('.home-hero');
      const slides = Array.from(slideshow.querySelectorAll('[data-home-hero-slide]'));
      if (!section || slides.length < 2) return;

      const previousButton = section.querySelector('[data-home-hero-previous]');
      const nextButton = section.querySelector('[data-home-hero-next]');
      const toggleButton = section.querySelector('[data-home-hero-toggle]');
      const toggleIcon = toggleButton && toggleButton.querySelector('[data-home-hero-toggle-icon]');
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const autoRotate = slideshow.dataset.autoRotate === 'true';
      const interval = Number(slideshow.dataset.rotationInterval) || 5000;
      const controller = new AbortController();
      let currentIndex = Math.max(slides.findIndex((slide) => slide.classList.contains('is-active')), 0);
      let timer = null;
      let hovered = false;
      let focused = false;
      let userPaused = false;
      let userStarted = false;

      const shouldRotate = () => autoRotate
        && !userPaused
        && !hovered
        && !focused
        && (!prefersReducedMotion.matches || userStarted);

      const updateToggle = () => {
        if (!toggleButton) return;
        const rotating = shouldRotate();
        toggleButton.setAttribute('aria-label', rotating ? toggleButton.dataset.pauseLabel : toggleButton.dataset.resumeLabel);
        if (toggleIcon) toggleIcon.textContent = rotating ? 'II' : '>';
      };

      const clearTimer = () => {
        if (timer !== null) window.clearTimeout(timer);
        timer = null;
      };

      const showSlide = (targetIndex) => {
        slides[currentIndex].classList.remove('is-active');
        slides[currentIndex].setAttribute('aria-hidden', 'true');
        currentIndex = (targetIndex + slides.length) % slides.length;
        slides[currentIndex].classList.add('is-active');
        slides[currentIndex].setAttribute('aria-hidden', 'false');
      };

      const schedule = () => {
        clearTimer();
        updateToggle();
        if (!shouldRotate()) return;
        timer = window.setTimeout(() => {
          showSlide(currentIndex + 1);
          schedule();
        }, interval);
      };

      if (previousButton) {
        previousButton.addEventListener('click', () => {
          showSlide(currentIndex - 1);
          schedule();
        }, { signal: controller.signal });
      }

      if (nextButton) {
        nextButton.addEventListener('click', () => {
          showSlide(currentIndex + 1);
          schedule();
        }, { signal: controller.signal });
      }

      if (toggleButton) {
        toggleButton.addEventListener('click', () => {
          if (userPaused) {
            userPaused = false;
            userStarted = true;
          } else if (prefersReducedMotion.matches && !userStarted) {
            userStarted = true;
          } else {
            userPaused = true;
          }
          schedule();
        }, { signal: controller.signal });
      }

      section.addEventListener('mouseenter', () => {
        hovered = true;
        schedule();
      }, { signal: controller.signal });
      section.addEventListener('mouseleave', () => {
        hovered = false;
        schedule();
      }, { signal: controller.signal });
      section.addEventListener('focusin', () => {
        focused = true;
        schedule();
      }, { signal: controller.signal });
      section.addEventListener('focusout', (event) => {
        if (!section.contains(event.relatedTarget)) {
          focused = false;
          schedule();
        }
      }, { signal: controller.signal });
      prefersReducedMotion.addEventListener('change', schedule, { signal: controller.signal });

      instances.set(slideshow, {
        destroy: () => {
          clearTimer();
          controller.abort();
        }
      });
      schedule();
    };

    const initializeWithin = (context) => findSlideshows(context).forEach(initialize);
    const destroyWithin = (context) => {
      findSlideshows(context).forEach((slideshow) => {
        const instance = instances.get(slideshow);
        if (instance) instance.destroy();
        instances.delete(slideshow);
      });
    };

    document.addEventListener('shopify:section:load', (event) => initializeWithin(event.target));
    document.addEventListener('shopify:section:unload', (event) => destroyWithin(event.target));

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => initializeWithin(document), { once: true });
    } else {
      initializeWithin(document);
    }
  })();
{% endjavascript %}

{% render 'section-color-scheme', section: section %}

{% render 'section-spacing', section: section %}

{% schema %}
{
  "name": "t:general.home_hero",
  "max_blocks": 6,
  "blocks": [
    {
      "type": "slide",
      "name": "t:sections.home_hero.blocks.slide.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "desktop_image",
          "label": "t:sections.home_hero.blocks.slide.settings.desktop_image.label",
          "info": "t:sections.home_hero.blocks.slide.settings.desktop_image.info"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "t:sections.home_hero.blocks.slide.settings.mobile_image.label",
          "info": "t:sections.home_hero.blocks.slide.settings.mobile_image.info"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "range",
      "id": "section_space_above",
      "label": "t:labels.section_space_above",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_space_below",
      "label": "t:labels.section_space_below",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    { "type": "checkbox", "id": "use_color_scheme", "label": "t:labels.use_color_scheme", "default": false },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:labels.color_scheme", "default": "scheme-1", "visible_if": "{{ section.settings.use_color_scheme }}" },
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "t:sections.home_hero.settings.desktop_image.label",
      "info": "t:sections.home_hero.settings.desktop_image.info"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "t:sections.home_hero.settings.mobile_image.label",
      "info": "t:sections.home_hero.settings.mobile_image.info"
    },
    {
      "type": "checkbox",
      "id": "auto_rotate",
      "label": "t:sections.home_hero.settings.auto_rotate.label",
      "default": true
    },
    {
      "type": "range",
      "id": "rotation_interval",
      "label": "t:sections.home_hero.settings.rotation_interval.label",
      "min": 2,
      "max": 12,
      "step": 1,
      "unit": "s",
      "default": 5
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.home_hero.settings.eyebrow.label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.home_hero.settings.heading.label",
      "default": "Thoughtful finds for everyday life"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "t:sections.home_hero.settings.subheading.label"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.home_hero.settings.button_label.label",
      "default": "Shop the collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.home_hero.settings.button_link.label"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "t:labels.button_style",
      "options": [
        { "value": "primary", "label": "t:options.button_style.primary" },
        { "value": "secondary", "label": "t:options.button_style.secondary" },
        { "value": "tertiary", "label": "t:options.button_style.tertiary" }
      ],
      "default": "primary"
    },
    {
      "type": "checkbox",
      "id": "customize_button_colors",
      "label": "t:sections.home_hero.settings.customize_button_colors.label",
      "default": false
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "t:sections.home_hero.settings.button_color.label",
      "default": "#D4A04E",
      "visible_if": "{{ section.settings.customize_button_colors }}"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "t:sections.home_hero.settings.button_text_color.label",
      "default": "#FFFFFF",
      "visible_if": "{{ section.settings.customize_button_colors }}"
    },
    {
      "type": "range",
      "id": "desktop_height",
      "label": "t:sections.home_hero.settings.desktop_height.label",
      "min": 400,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 640
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "t:sections.home_hero.settings.mobile_height.label",
      "min": 360,
      "max": 760,
      "step": 20,
      "unit": "px",
      "default": 560
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "t:sections.home_hero.settings.overlay_opacity.label",
      "min": 0,
      "max": 70,
      "step": 5,
      "unit": "%",
      "default": 20
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "t:sections.home_hero.settings.overlay_color.label",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:sections.home_hero.settings.text_color.label",
      "default": "#FFFFFF"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "t:sections.home_hero.settings.text_alignment.label",
      "options": [
        { "value": "left", "label": "t:options.alignment.left" },
        { "value": "center", "label": "t:options.alignment.center" },
        { "value": "right", "label": "t:options.alignment.right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "t:sections.home_hero.settings.vertical_alignment.label",
      "options": [
        { "value": "top", "label": "t:options.vertical_alignment.top" },
        { "value": "center", "label": "t:options.vertical_alignment.center" },
        { "value": "bottom", "label": "t:options.vertical_alignment.bottom" }
      ],
      "default": "center"
    }
  ],
  "presets": [
    {
      "name": "t:general.home_hero"
    }
  ]
}
{% endschema %}
