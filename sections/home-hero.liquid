<section
  class="home-hero full-width home-hero--{{ section.settings.text_alignment }} home-hero--{{ section.settings.vertical_alignment }}{% if section.settings.desktop_image == blank and section.settings.mobile_image == blank %} home-hero--without-image{% endif %}"
  style="--home-hero-desktop-height: {{ section.settings.desktop_height }}px; --home-hero-mobile-height: {{ section.settings.mobile_height }}px; --home-hero-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }}; --home-hero-overlay-color: {{ section.settings.overlay_color }}; --home-hero-text-color: {{ section.settings.text_color }}"
>
  {%- assign hero_heading = section.settings.heading -%}
  {%- assign hero_image = section.settings.desktop_image | default: section.settings.mobile_image -%}
  <picture class="home-hero__media">
    {%- if section.settings.mobile_image != blank -%}
      <source
        media="(max-width: 749px)"
        srcset="{{ section.settings.mobile_image | image_url: width: 1200 }}"
      >
    {%- endif -%}
    {%- if hero_image != blank -%}
      {{ hero_image | image_url: width: 2400 | image_tag: class: 'home-hero__image', widths: '750, 1100, 1500, 1900, 2400', sizes: '100vw', loading: 'eager', alt: hero_heading }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'home-hero__image home-hero__placeholder' }}
    {%- endif -%}
  </picture>
  <span class="home-hero__overlay" aria-hidden="true"></span>

  <div class="home-hero__content">
    {%- if section.settings.eyebrow != blank -%}
      <p class="home-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if hero_heading != blank -%}
      <h1>{{ hero_heading | escape }}</h1>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="home-hero__subheading">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}
    {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
      <a class="home-hero__button" href="{{ section.settings.button_link }}">
        {{ section.settings.button_label | escape }}
        <span aria-hidden="true">&#8599;</span>
      </a>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .home-hero {
    position: relative;
    display: flex;
    min-height: var(--home-hero-desktop-height);
    align-items: center;
    overflow: hidden;
    background: #e8e8e1;
    color: var(--home-hero-text-color);
  }

  .home-hero__media,
  .home-hero__overlay {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  .home-hero__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .home-hero--without-image {
    color: #20211e;
  }

  .home-hero__overlay {
    background-color: var(--home-hero-overlay-color);
    opacity: var(--home-hero-overlay-opacity);
  }

  .home-hero__content {
    position: relative;
    z-index: 1;
    width: min(100% - 48px, 1440px);
    margin-inline: auto;
    padding-block: 56px;
  }

  .home-hero--center .home-hero__content {
    text-align: center;
  }

  .home-hero--right .home-hero__content {
    text-align: right;
  }

  .home-hero--top {
    align-items: flex-start;
  }

  .home-hero--bottom {
    align-items: flex-end;
  }

  .home-hero__eyebrow {
    margin-block-end: 12px;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
  }

  .home-hero h1 {
    max-width: 760px;
    margin: 0;
    font-family: var(--font-primary--family);
    font-size: 56px;
    font-weight: 600;
    line-height: 1.05;
  }

  .home-hero--center h1 {
    margin-inline: auto;
  }

  .home-hero--right h1 {
    margin-inline-start: auto;
  }

  .home-hero__subheading {
    max-width: 620px;
    margin-block-start: 16px;
    font-size: 16px;
    line-height: 1.6;
  }

  .home-hero--center .home-hero__subheading {
    margin-inline: auto;
  }

  .home-hero--right .home-hero__subheading {
    margin-inline-start: auto;
  }

  .home-hero__button {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-block-start: 24px;
    padding-inline: 16px;
    border: 1px solid currentColor;
    background: var(--color-background, #fff);
    color: var(--color-foreground, #20211e);
    font-size: 12px;
    font-weight: 600;
    text-decoration: none;
  }

  .home-hero__button:hover {
    opacity: 0.82;
  }

  @media (max-width: 749px) {
    .home-hero {
      min-height: var(--home-hero-mobile-height);
    }

    .home-hero__content {
      width: calc(100% - 40px);
      padding-block: 32px;
    }

    .home-hero h1 {
      font-size: 36px;
    }

    .home-hero__subheading {
      margin-block-start: 12px;
      font-size: 14px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.home_hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "t:sections.home_hero.settings.desktop_image.label"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "t:sections.home_hero.settings.mobile_image.label"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.home_hero.settings.eyebrow.label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.home_hero.settings.heading.label",
      "default": "Thoughtful finds for everyday life"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "t:sections.home_hero.settings.subheading.label"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.home_hero.settings.button_label.label",
      "default": "Shop the collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.home_hero.settings.button_link.label"
    },
    {
      "type": "range",
      "id": "desktop_height",
      "label": "t:sections.home_hero.settings.desktop_height.label",
      "min": 400,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 640
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "t:sections.home_hero.settings.mobile_height.label",
      "min": 360,
      "max": 760,
      "step": 20,
      "unit": "px",
      "default": 560
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "t:sections.home_hero.settings.overlay_opacity.label",
      "min": 0,
      "max": 70,
      "step": 5,
      "unit": "%",
      "default": 20
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "t:sections.home_hero.settings.overlay_color.label",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:sections.home_hero.settings.text_color.label",
      "default": "#FFFFFF"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "t:sections.home_hero.settings.text_alignment.label",
      "options": [
        { "value": "left", "label": "t:options.alignment.left" },
        { "value": "center", "label": "t:options.alignment.center" },
        { "value": "right", "label": "t:options.alignment.right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "t:sections.home_hero.settings.vertical_alignment.label",
      "options": [
        { "value": "top", "label": "t:options.vertical_alignment.top" },
        { "value": "center", "label": "t:options.vertical_alignment.center" },
        { "value": "bottom", "label": "t:options.vertical_alignment.bottom" }
      ],
      "default": "center"
    }
  ],
  "presets": [
    {
      "name": "t:general.home_hero"
    }
  ]
}
{% endschema %}
