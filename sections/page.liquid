{% comment %}
  This section is used in the page template to render store pages like About us
  or Contact us.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/page
{% endcomment %}

<section class="page-content{% if page.handle == 'frequently-asked-questions' %} page-content--faq{% endif %} full-width">
  <header class="page-content__header">
    <h1 class="page-content__title section-heading--primary">{{ page.title | escape }}</h1>
    <span class="page-content__accent" aria-hidden="true"></span>
  </header>

  <div class="page-content__body page-content__richtext rte">
    {{ page.content }}
  </div>
</section>

{% render 'informational-page-styles' %}

{% render 'section-color-scheme', section: section %}

{% render 'section-heading-typography', section: section %}

{% render 'section-spacing', section: section %}

{% schema %}
{
  "name": "t:general.page",
  "settings": [
    { "type": "checkbox", "id": "customize_heading_typography", "label": "t:labels.customize_heading_typography", "default": false },
    { "type": "font_picker", "id": "heading_font", "label": "t:labels.heading_font", "default": "montserrat_n4", "visible_if": "{{ section.settings.customize_heading_typography }}" },
    { "type": "range", "id": "heading_size", "label": "t:labels.heading_size", "min": 12, "max": 96, "step": 2, "unit": "px", "default": 40, "visible_if": "{{ section.settings.customize_heading_typography }}" },
    {
      "type": "range",
      "id": "section_space_above",
      "label": "t:labels.section_space_above",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_space_below",
      "label": "t:labels.section_space_below",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    { "type": "checkbox", "id": "use_color_scheme", "label": "t:labels.use_color_scheme", "default": false },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:labels.color_scheme", "default": "scheme-1", "visible_if": "{{ section.settings.use_color_scheme }}" }
  ]
}
{% endschema %}
