{% comment %}
  This section is used in the page template to render store pages like About us
  or Contact us.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/page
{% endcomment %}

<section class="page-content full-width">
  <header class="page-content__header">
    <h1 class="page-content__title">{{ page.title | escape }}</h1>
    <span class="page-content__accent" aria-hidden="true"></span>
  </header>

  <div class="page-content__body rte">
    {{ page.content }}
  </div>
</section>

{% stylesheet %}
  .page-content {
    padding: clamp(32px, 5vw, 64px) var(--page-margin, 20px) clamp(56px, 7vw, 88px);
    background: var(--section-background, #f5f6f2);
    color: var(--section-foreground, var(--color-foreground, #20211e));
  }

  .page-content__header {
    margin: 0 auto clamp(28px, 4vw, 48px);
    text-align: center;
  }

  .page-content__title {
    font-family: var(--font-primary--family);
    font-size: clamp(32px, 5vw, 48px);
    font-weight: 500;
    line-height: 1.15;
    text-wrap: balance;
  }

  .page-content__accent {
    display: block;
    width: 48px;
    height: 3px;
    margin: 20px auto 0;
    background: currentColor;
    opacity: 0.35;
  }

  .page-content__body {
    width: min(100%, 860px);
    margin-inline: auto;
    padding: clamp(24px, 5vw, 56px);
    overflow-x: auto;
    background: var(--color-background, #fff);
    border: 1px solid color-mix(in srgb, currentColor 12%, transparent);
    border-radius: 4px;
    font-size: max(16px, var(--font-size-base, 14px));
    line-height: 1.75;
    overflow-wrap: break-word;
  }

  .page-content__body > * + * {
    margin-block-start: 1em;
  }

  .page-content__body :is(h1, h2, h3, h4, h5, h6) {
    line-height: 1.3;
    font-weight: 600;
  }

  .page-content__body :is(h1, h2) {
    font-size: clamp(22px, 2.5vw, 28px);
  }

  .page-content__body :is(h3, h4, h5, h6) {
    font-size: 1.1em;
  }

  .page-content__body :is(h1, h2, h3, h4, h5, h6):not(:first-child) {
    margin-block-start: 1.8em;
  }

  .page-content__body :is(ul, ol) {
    padding-inline-start: 1.5em;
  }

  .page-content__body li + li {
    margin-block-start: 0.4em;
  }

  .page-content__body a {
    color: var(--section-link, inherit);
    text-underline-offset: 3px;
  }

  .page-content__body a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  .page-content__body :is(img, video, iframe, table) {
    max-width: 100%;
  }
{% endstylesheet %}

{% render 'section-color-scheme', section: section %}

{% render 'section-spacing', section: section %}

{% schema %}
{
  "name": "t:general.page",
  "settings": [
    {
      "type": "range",
      "id": "section_space_above",
      "label": "t:labels.section_space_above",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_space_below",
      "label": "t:labels.section_space_below",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    { "type": "checkbox", "id": "use_color_scheme", "label": "t:labels.use_color_scheme", "default": false },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:labels.color_scheme", "default": "scheme-1", "visible_if": "{{ section.settings.use_color_scheme }}" }
  ]
}
{% endschema %}
