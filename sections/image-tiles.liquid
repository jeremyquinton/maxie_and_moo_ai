<section
  class="image-tiles full-width"
  style="--image-tiles-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }}"
>
  <div class="image-tiles__grid">
    {%- for block in section.blocks -%}
      <article
        class="image-tiles__item"
        style="--image-tile-position: {{ block.settings.image_position }}"
        {{ block.shopify_attributes }}
      >
        {%- if block.settings.image != blank -%}
          {{ block.settings.image | image_url: width: 1800 | image_tag: class: 'image-tiles__image', widths: '375, 550, 750, 1000, 1300, 1600, 1800', sizes: '(min-width: 750px) 33vw, 100vw', loading: 'lazy', alt: block.settings.heading }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'image-tiles__image image-tiles__placeholder' }}
        {%- endif -%}

        <span class="image-tiles__overlay" aria-hidden="true"></span>

        <div class="image-tiles__content">
          {%- if block.settings.heading != blank -%}
            <h2 class="image-tiles__heading">{{ block.settings.heading | escape }}</h2>
          {%- endif -%}
          {%- if block.settings.button_label != blank and block.settings.button_link != blank -%}
            <a class="image-tiles__button" href="{{ block.settings.button_link }}">
              {{ block.settings.button_label | escape }}
            </a>
          {%- endif -%}
        </div>
      </article>
    {%- endfor -%}
  </div>
</section>

{% stylesheet %}
  .image-tiles {
    width: 100%;
    padding: 4px 30px;
  }

  .image-tiles__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 30px;
  }

  .image-tiles__item {
    position: relative;
    min-width: 0;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: #e8e8e1;
    color: #fff;
  }

  .image-tiles__image {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--image-tile-position, center);
  }

  .image-tiles__overlay {
    position: absolute;
    inset: 0;
    background: rgb(0 0 0 / var(--image-tiles-overlay-opacity));
  }

  .image-tiles__content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    padding: 24px;
    text-align: center;
  }

  .image-tiles__heading {
    max-width: 100%;
    margin: 0;
    color: inherit;
    font-family: var(--font-primary--family);
    font-size: 24px;
    font-weight: 600;
    line-height: 1.15;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }

  .image-tiles__button {
    display: inline-flex;
    min-height: 40px;
    max-width: 100%;
    align-items: center;
    justify-content: center;
    padding: 10px 22px;
    background: var(--section-button, #fff);
    color: var(--section-button-text, #20211e);
    font-size: var(--font-size-base, 14px);
    font-weight: 600;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    overflow-wrap: anywhere;
    transition: background-color 160ms ease;
  }

  .image-tiles__button:hover {
    background: var(--section-button, #ededeb);
    filter: brightness(0.95);
  }

  .image-tiles__button:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }

  @media (max-width: 749px) {
    .image-tiles__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .image-tiles__item {
      aspect-ratio: 4 / 5;
    }

    .image-tiles__heading {
      font-size: 21px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .image-tiles__button {
      transition: none;
    }
  }
{% endstylesheet %}

{% render 'section-color-scheme', section: section %}

{% schema %}
{
  "name": "t:general.image_tiles",
  "max_blocks": 3,
  "blocks": [
    {
      "type": "tile",
      "name": "t:sections.image_tiles.blocks.tile.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.image_tiles.blocks.tile.settings.image.label"
        },
        {
          "type": "select",
          "id": "image_position",
          "label": "t:sections.image_tiles.blocks.tile.settings.image_position.label",
          "options": [
            { "value": "top", "label": "t:options.image_position.top" },
            { "value": "center", "label": "t:options.image_position.center" },
            { "value": "bottom", "label": "t:options.image_position.bottom" }
          ],
          "default": "center"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.image_tiles.blocks.tile.settings.heading.label"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "t:sections.image_tiles.blocks.tile.settings.button_label.label",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "t:sections.image_tiles.blocks.tile.settings.button_link.label"
        }
      ]
    }
  ],
  "settings": [
    { "type": "checkbox", "id": "use_color_scheme", "label": "t:labels.use_color_scheme", "default": false },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:labels.color_scheme", "default": "scheme-1", "visible_if": "{{ section.settings.use_color_scheme }}" },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "t:sections.image_tiles.settings.overlay_opacity.label",
      "min": 0,
      "max": 40,
      "step": 5,
      "unit": "%",
      "default": 15
    }
  ],
  "presets": [
    {
      "name": "t:general.image_tiles",
      "blocks": [
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile" }
      ]
    }
  ]
}
{% endschema %}