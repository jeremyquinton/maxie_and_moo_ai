{% javascript %}
  if (!customElements.get('product-details')) {
    customElements.define('product-details', class ProductDetails extends HTMLElement {
      connectedCallback() {
        if (this.dataset.initialized) return;
        this.dataset.initialized = 'true';
        this.listenerController = new AbortController();
        const { signal } = this.listenerController;
        this.handlePopState = () => this.loadColorProduct(window.location.href, false);
        window.addEventListener('popstate', this.handlePopState, { signal });
        this.form = this.querySelector('[data-product-form]');
        this.variants = JSON.parse(this.querySelector('[data-product-variant-json]').textContent);
        this.variantInput = this.form.querySelector('[data-variant-id]');
        this.addButton = this.form.querySelector('[data-add-button]');
        this.addLabel = this.form.querySelector('[data-add-label]');
        this.status = this.form.querySelector('[data-product-stock]');
        this.error = this.form.querySelector('[data-form-error]');
        this.price = this.querySelector('[data-product-price]');
        this.comparePrice = this.querySelector('[data-product-compare-price]');
        this.saleBadge = this.querySelector('[data-sale-badge]');
        this.sku = this.form.querySelector('[data-product-sku]');
        this.lightbox = this.querySelector('[data-product-lightbox]');
        this.lightboxImage = this.lightbox.querySelector('[data-lightbox-image]');
        this.lightboxCount = this.lightbox.querySelector('[data-lightbox-count]');
        this.colorStatus = this.querySelector('[data-color-status]');
        this.tabButtons = [...this.querySelectorAll('[data-product-tab-button]')];
        this.tabPanels = [...this.querySelectorAll('[data-product-tab-panel]')];
        this.tabButtons.forEach((button) => {
          button.addEventListener('click', () => this.activateTab(button.dataset.productTabButton), { signal });
        });
        this.form.querySelectorAll('[data-size-dropdown-toggle]').forEach((button) => {
          button.addEventListener('click', () => this.toggleSizeDropdown(button.closest('[data-size-dropdown]')), { signal });
        });

        this.addEventListener('click', (event) => {
          if (!event.target.closest('[data-size-dropdown]')) {
            this.closeSizeDropdowns();
          }
        }, { signal });

        window.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') this.closeSizeDropdowns();
        }, { signal });

        this.form.querySelectorAll('[data-option-input]').forEach((input) => {
          input.addEventListener('change', () => {
            this.updateVariant();
            this.closeSizeDropdowns();
          }, { signal });
        });

        this.querySelectorAll('[data-gallery-thumbnail]').forEach((thumbnail) => {
          thumbnail.addEventListener('click', () => this.showImage(thumbnail.dataset.imageId), { signal });
        });

        this.querySelectorAll('[data-gallery-step]').forEach((button) => {
          button.addEventListener('click', () => this.stepImage(Number(button.dataset.galleryStep)), { signal });
        });

        this.querySelectorAll('[data-gallery-open]').forEach((button) => {
          button.addEventListener('click', (event) => {
            if (performance.now() < (this.galleryClickSuppressUntil || 0)) {
              event.preventDefault();
              return;
            }
            this.openLightbox();
          }, { signal });
        });

        this.addEventListener('click', (event) => {
          const link = event.target.closest?.('[data-color-product-link]');
          if (!link || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
          event.preventDefault();
          this.loadColorProduct(link.href, true, link);
        }, { signal });

        this.lightbox.querySelector('[data-lightbox-close]').addEventListener('click', () => this.lightbox.close(), { signal });
        this.lightbox.addEventListener('click', (event) => {
          if (event.target === this.lightbox) this.lightbox.close();
        }, { signal });

        this.form.querySelectorAll('[data-quantity-change]').forEach((button) => {
          button.addEventListener('click', () => {
            const quantity = this.form.querySelector('input[name="quantity"]');
            quantity.value = String(Math.max(1, Number(quantity.value || 1) + Number(button.dataset.quantityChange)));
          }, { signal });
        });

        this.form.addEventListener('submit', (event) => {
          if (!this.variantInput.value || this.addButton.disabled) {
            event.preventDefault();
            this.error.hidden = false;
          }
        }, { signal });

        this.updateSizeOptionPrices();
        this.updateVariant();
        this.activateTab('description');
      }

      disconnectedCallback() {
        this.listenerController?.abort();
        this.colorAbortController?.abort();
        delete this.dataset.initialized;
      }

      async loadColorProduct(href, addHistory = true, colorLink = null) {
        this.colorAbortController?.abort();
        this.colorAbortController = new AbortController();
        const requestId = (this.colorRequestId || 0) + 1;
        this.colorRequestId = requestId;
        this.dataset.loadingColor = 'true';
        this.setAttribute('aria-busy', 'true');

        const destination = new URL(href, window.location.href);
        this.preservePreviewContext(destination);
        if (colorLink) {
          const matchingVariant = this.findMatchingVariant(colorLink);
          if (matchingVariant) destination.searchParams.set('variant', matchingVariant.id);
          else destination.searchParams.delete('variant');
        }
        const requestUrl = new URL(destination);
        requestUrl.searchParams.set('section_id', this.dataset.sectionId);

        if (this.colorStatus) {
          this.colorStatus.textContent = this.dataset.labelLoadingColor;
          this.colorStatus.hidden = false;
        }
        this.form.setAttribute('aria-busy', 'true');
        this.form.querySelectorAll('button, input:not([type="hidden"]), select').forEach((control) => {
          control.disabled = true;
        });

        try {
          const response = await fetch(requestUrl, {
            headers: { Accept: 'text/html' },
            signal: this.colorAbortController.signal
          });
          if (!response.ok) throw new Error('Unable to load product section');

          const markup = await response.text();
          const responseDocument = new DOMParser().parseFromString(markup, 'text/html');
          const nextProduct = responseDocument.querySelector('product-details[data-product-page]');
          if (!nextProduct) throw new Error('Product section was missing from the response');
          if (requestId !== this.colorRequestId) return;

          const nextTitle = nextProduct.querySelector('.product-title')?.textContent.trim();
          const scrollX = window.scrollX;
          const scrollY = window.scrollY;
          const canonicalUrl = nextProduct.dataset.canonicalUrl || destination.pathname;
          this.colorAbortController = null;
          this.replaceWith(nextProduct);
          if (addHistory) window.history.pushState({}, '', destination);
          if (nextTitle) document.title = `${nextTitle} – ${this.dataset.storeName}`;
          const canonicalLink = document.querySelector('link[rel="canonical"]');
          if (canonicalLink) canonicalLink.href = canonicalUrl;
          window.scrollTo(scrollX, scrollY);
          nextProduct.querySelector('.product-title')?.focus({ preventScroll: true });
        } catch (error) {
          if (error.name === 'AbortError' || requestId !== this.colorRequestId) return;
          if (this.colorStatus) this.colorStatus.textContent = this.dataset.labelColorLoadError;
          window.location.assign(destination.href);
        } finally {
          if (requestId === this.colorRequestId && this.isConnected) {
            this.dataset.loadingColor = 'false';
            this.removeAttribute('aria-busy');
            this.form.removeAttribute('aria-busy');
            this.form.querySelectorAll('button, input:not([type="hidden"]), select').forEach((control) => {
              control.disabled = false;
            });
          }
        }
      }

      preservePreviewContext(destination) {
        const currentUrl = new URL(window.location.href);
        ['preview_theme_id', '_fd', 'pb'].forEach((key) => {
          if (currentUrl.searchParams.has(key) && !destination.searchParams.has(key)) {
            destination.searchParams.set(key, currentUrl.searchParams.get(key));
          }
        });
      }

      findMatchingVariant(colorLink) {
        const variants = JSON.parse(colorLink.dataset.productVariants || '[]');
        const targetOptions = JSON.parse(colorLink.dataset.productOptions || '[]');
        const currentSelections = new Map(
          [...this.form.querySelectorAll('[data-option-group]')]
            .map((group) => [group.dataset.optionName.trim().toLowerCase(), this.getGroupValue(group)])
            .filter(([, value]) => value !== undefined)
        );
        const uniqueValues = targetOptions.map((_, index) => [...new Set(variants.map((variant) => variant.options[index]))]);

        return variants.find((variant) => targetOptions.every((name, index) => {
          const key = name.trim().toLowerCase();
          if (currentSelections.has(key)) return variant.options[index] === currentSelections.get(key);
          return uniqueValues[index].length === 1 && variant.options[index] === uniqueValues[index][0];
        })) || null;
      }

      getGroupValue(group) {
        const input = group.querySelector('[data-option-input]');
        if (!input) return undefined;
        return group.querySelector('[data-option-input]:checked')?.value;
      }

      updateSizeOptionPrices(selectedOptions = null) {
        const optionGroups = [...this.form.querySelectorAll('[data-option-group]')];
        const currentSelections = selectedOptions || optionGroups.map((group) => this.getGroupValue(group));

        optionGroups.forEach((group, optionIndex) => {
          if (group.dataset.optionStyle !== 'size') return;
          [...group.querySelectorAll('[data-size-dropdown-item]')].forEach((item) => {
            const optionElement = item.querySelector('input[data-option-input]');
            const itemLabel = item.querySelector('[data-size-dropdown-item-label]');
            if (!optionElement || !itemLabel) return;

            const matchingVariant = this.variants.find((variant) => variant.options.every((value, index) => {
              if (index === optionIndex) return value === optionElement.value;
              const selectedValue = currentSelections[index];
              return selectedValue === undefined || selectedValue === value;
            }));

            itemLabel.textContent = matchingVariant
              ? `${optionElement.value} - ${this.formatMoney(matchingVariant.price)}`
              : optionElement.value;
          });

          const toggleLabel = group.querySelector('[data-size-dropdown-label]');
          const checkedItemLabel = group.querySelector('[data-size-dropdown-item] input[data-option-input]:checked')
            ?.closest('[data-size-dropdown-item]')
            ?.querySelector('[data-size-dropdown-item-label]');
          if (toggleLabel && checkedItemLabel) {
            toggleLabel.textContent = checkedItemLabel.textContent;
          } else if (toggleLabel && currentSelections[optionIndex]) {
            toggleLabel.textContent = currentSelections[optionIndex];
          }
        });
      }

      toggleSizeDropdown(dropdown) {
        if (!dropdown) return;
        const isOpen = dropdown.dataset.sizeDropdownOpen === 'true';
        this.closeSizeDropdowns();
        if (!isOpen) {
          dropdown.dataset.sizeDropdownOpen = 'true';
          dropdown.querySelector('[data-size-dropdown-toggle]')?.setAttribute('aria-expanded', 'true');
          dropdown.querySelector('[data-size-dropdown-menu]')?.removeAttribute('hidden');
        }
      }

      closeSizeDropdowns() {
        this.querySelectorAll('[data-size-dropdown]').forEach((dropdown) => {
          dropdown.dataset.sizeDropdownOpen = 'false';
          dropdown.querySelector('[data-size-dropdown-toggle]')?.setAttribute('aria-expanded', 'false');
          dropdown.querySelector('[data-size-dropdown-menu]')?.setAttribute('hidden', 'hidden');
        });
      }

      updateVariant() {
        const optionGroups = [...this.form.querySelectorAll('[data-option-group]')];
        const selectedOptions = optionGroups.map((group) => this.getGroupValue(group));
        optionGroups.forEach((group, index) => {
          const optionName = group.dataset.optionName.toLowerCase();
          const fallbackLabel = optionName.includes('size') ? this.dataset.labelChooseSize : this.dataset.labelChooseOption;
          group.querySelector('[data-option-selected]').textContent = selectedOptions[index] || fallbackLabel;
        });
        this.updateSizeOptionPrices(selectedOptions);

        const missingGroup = optionGroups.find((group, index) => group.dataset.optionRequired === 'true' && !selectedOptions[index]);
        const missingRequiredOption = Boolean(missingGroup);
        const missingLabel = missingGroup?.dataset.optionName.toLowerCase().includes('size')
          ? this.dataset.labelChooseSize
          : this.dataset.labelChooseOption;
        const variant = missingRequiredOption ? null : this.variants.find((item) => item.options.every((value, index) => value === selectedOptions[index]));
        this.error.hidden = true;

        if (!variant) {
          this.variantInput.value = '';
          this.addButton.disabled = true;
          this.addLabel.textContent = missingRequiredOption ? missingLabel : this.dataset.labelUnavailable;
          this.status.textContent = missingRequiredOption ? missingLabel : this.dataset.labelCombinationUnavailable;
          if (this.sku) this.sku.hidden = true;
          this.comparePrice.hidden = true;
          this.saleBadge.hidden = true;
          this.price.textContent = this.formatMoney(Number(this.form.dataset.priceMin));
          const url = new URL(window.location.href);
          url.searchParams.delete('variant');
          window.history.replaceState({}, '', url);
          this.updateColorSwatchLinks();
          return;
        }

        this.variantInput.value = variant.id;
        this.price.textContent = this.formatMoney(variant.price);
        const onSale = Number(variant.compare_at_price) > Number(variant.price);
        this.comparePrice.hidden = !onSale;
        this.comparePrice.textContent = onSale ? this.formatMoney(variant.compare_at_price) : '';
        this.saleBadge.hidden = !onSale;
        this.addButton.disabled = !variant.available;
        this.addLabel.textContent = variant.available ? this.dataset.labelAddToCart : this.dataset.labelSoldOut;
        this.status.textContent = this.getStockLabel(variant);
        if (this.sku) {
          this.sku.hidden = !variant.sku;
          const skuValue = this.sku.querySelector('span');
          if (skuValue) skuValue.textContent = variant.sku || '';
        }

        const imageId = variant.featured_media?.id || variant.featured_image?.id;
        if (imageId) this.showImage(imageId);

        const url = new URL(window.location.href);
        url.searchParams.set('variant', variant.id);
        window.history.replaceState({}, '', url);
        this.updateColorSwatchLinks();
      }

      formatMoney(cents) {
        const currencyCode = this.form.dataset.currency || 'USD';

        if (window.Shopify?.formatMoney) {
          return window.Shopify
            .formatMoney(cents, this.form.dataset.moneyFormat)
            .replace(/\bZAR\b\s*/g, 'R ')
            .replace(/\bZAR\b/g, 'R');
        }

        try {
          return new Intl.NumberFormat(document.documentElement.lang || undefined, {
            style: 'currency',
            currency: currencyCode,
            currencyDisplay: currencyCode === 'ZAR' ? 'narrowSymbol' : 'symbol'
          }).format(Number(cents) / 100);
        } catch {
          const amount = (Number(cents) / 100).toFixed(2);
          return currencyCode === 'ZAR' ? `R ${amount}` : amount;
        }
      }

      getStockLabel(variant) {
        if (!variant.available) return this.dataset.labelSoldOut;
        if (variant.inventory_management && variant.inventory_quantity > 0 && variant.inventory_quantity <= 3) {
          return this.dataset.labelOnlyLeft.replace('__COUNT__', variant.inventory_quantity);
        }
        return this.dataset.labelInStock;
      }

      updateColorSwatchLinks() {
        this.querySelectorAll('[data-color-product-link]').forEach((link) => {
          const matchingVariant = this.findMatchingVariant(link);
          const destination = new URL(link.dataset.productUrl, window.location.href);
          if (matchingVariant) destination.searchParams.set('variant', matchingVariant.id);
          else destination.searchParams.delete('variant');
          this.preservePreviewContext(destination);
          link.href = destination.href;
        });
      }

      activateTab(tabName) {
        if (!tabName) return;
        this.tabButtons?.forEach((button) => {
          const active = button.dataset.productTabButton === tabName;
          button.classList.toggle('is-active', active);
          button.setAttribute('aria-selected', String(active));
          button.tabIndex = active ? 0 : -1;
        });
        this.tabPanels?.forEach((panel) => {
          const active = panel.dataset.productTabPanel === tabName;
          panel.hidden = !active;
          panel.classList.toggle('is-active', active);
        });
      }

      showImage(imageId) {
        const gallery = this.querySelector('[data-product-gallery]');
        gallery.querySelectorAll('[data-gallery-thumbnail]').forEach((thumbnail) => {
          const active = thumbnail.dataset.imageId === String(imageId);
          thumbnail.classList.toggle('is-active', active);
          thumbnail.setAttribute('aria-pressed', String(active));
        });
        gallery.querySelectorAll('[data-gallery-image]').forEach((image) => {
          const active = image.dataset.imageId === String(imageId);
          image.hidden = !active;
          image.classList.toggle('is-active', active);
        });
        if (this.lightbox.open) this.syncLightboxImage();
      }

      openLightbox() {
        this.syncLightboxImage();
        this.lightbox.showModal();
      }

      syncLightboxImage() {
        const images = [...this.querySelectorAll('[data-gallery-image]')];
        const activeIndex = images.findIndex((image) => !image.hidden);
        const activeImage = images[activeIndex]?.querySelector('img');
        if (!activeImage) return;
        this.lightboxImage.src = activeImage.currentSrc || activeImage.src;
        this.lightboxImage.alt = activeImage.alt;
        this.lightboxCount.textContent = `${activeIndex + 1} / ${images.length}`;
      }

      stepImage(direction) {
        const images = [...this.querySelectorAll('[data-gallery-image]')];
        const activeIndex = images.findIndex((image) => !image.hidden);
        const nextIndex = (activeIndex + direction + images.length) % images.length;
        this.showImage(images[nextIndex].dataset.imageId);
      }
    });
  }
