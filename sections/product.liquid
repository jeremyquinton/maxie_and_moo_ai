{%- liquid
  assign current_variant = product.selected_variant | default: product.selected_or_first_available_variant | default: product.variants.first
  assign active_media = current_variant.featured_media | default: product.featured_media
  assign product_images = product.media | where: 'media_type', 'image'
  assign first_image_id = blank
  assign product_form_id = 'ProductForm-' | append: section.id
  assign related_color_products = product.metafields.custom.colour_products.value
  assign selected_size = blank
  assign has_selected_variant = true
  assign has_size_option = false

  unless product.has_only_default_variant or product.selected_variant != blank
    assign has_selected_variant = false
  endunless

  for option in product.options_with_values
    assign option_name = option.name | downcase
    if option_name contains 'size'
      assign has_size_option = true
      if has_selected_variant
        assign selected_size = current_variant.options[forloop.index0]
      else
        assign selected_size = option.values.first
      endif
    endif
  endfor

  for media in product_images
    assign first_image_id = media.id
    break
  endfor

  assign active_image_id = active_media.id | default: first_image_id
  if active_media.media_type != 'image'
    assign active_image_id = first_image_id
  endif
-%}

<product-details
  class="product-page"
  data-product-page
  data-section-id="{{ section.id }}"
  data-store-name="{{ shop.name | escape }}"
  data-canonical-url="{{ canonical_url }}"
  data-label-add-to-cart="{{ 'products.product.add_to_cart' | t | escape }}"
  data-label-sold-out="{{ 'products.product.sold_out' | t | escape }}"
  data-label-unavailable="{{ 'products.product.unavailable' | t | escape }}"
  data-label-combination-unavailable="{{ 'products.product.combination_unavailable' | t | escape }}"
  data-label-choose-option="{{ 'products.product.choose_option' | t | escape }}"
  data-label-choose-size="{{ 'products.product.choose_size' | t | escape }}"
  data-label-loading-color="{{ 'products.product.loading_color' | t | escape }}"
  data-label-color-load-error="{{ 'products.product.color_load_error' | t | escape }}"
  data-label-in-stock="{{ 'products.product.in_stock' | t | escape }}"
  data-label-only-left="{{ 'products.product.only_left' | t: count: '__COUNT__' | escape }}"
  data-label-open-image="{{ 'products.product.open_image' | t | escape }}"
>
  <nav class="product-breadcrumbs" aria-label="Breadcrumb">
    <a href="{{ routes.root_url }}">{{ 'products.product.home' | t }}</a>
    <span aria-hidden="true">/</span>
    {%- if product.collections.first -%}
      <a href="{{ product.collections.first.url }}">{{ product.collections.first.title | escape }}</a>
      <span aria-hidden="true">/</span>
    {%- endif -%}
    <span aria-current="page">{{ product.title | escape }}</span>
  </nav>

  <div class="product-layout">
    <div class="product-gallery" data-product-gallery>
      <div class="product-gallery__stage" data-gallery-swipe-stage>
        {%- if product_images.size > 0 -%}
          {%- for media in product_images -%}
            <div class="product-gallery__image{% if media.id == active_image_id %} is-active{% endif %}" data-gallery-image data-image-id="{{ media.id }}"{% unless media.id == active_image_id %} hidden{% endunless %}>
              {%- assign image_loading = 'lazy' -%}
              {%- if media.id == active_image_id -%}{%- assign image_loading = 'eager' -%}{%- endif -%}
              <button class="product-gallery__open" type="button" data-gallery-open aria-label="{{ 'products.product.open_image' | t }}">
                {{ media.preview_image | image_url: width: 1800 | image_tag: class: 'product-gallery__photo', widths: '600, 900, 1200, 1600, 1800', sizes: '(min-width: 1000px) 56vw, 100vw', loading: image_loading, alt: media.alt | default: product.title }}
              </button>
            </div>
          {%- endfor -%}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'product-gallery__placeholder' }}
        {%- endif -%}
        {%- if product_images.size > 1 -%}
          <span class="product-gallery__count">{{ 'products.product.image_count' | t: count: product_images.size }}</span>
          <button class="product-gallery__step product-gallery__step--previous" type="button" data-gallery-step="-1" aria-label="{{ 'products.product.previous_image' | t }}">&#8592;</button>
          <button class="product-gallery__step product-gallery__step--next" type="button" data-gallery-step="1" aria-label="{{ 'products.product.next_image' | t }}">&#8594;</button>
        {%- endif -%}
      </div>

      {%- if product_images.size > 1 -%}
        <div class="product-gallery__thumbnails" aria-label="{{ 'products.product.gallery_thumbnails' | t }}">
          {%- for media in product_images -%}
            <button
              class="product-gallery__thumbnail{% if media.id == active_image_id %} is-active{% endif %}"
              type="button"
              data-gallery-thumbnail
              data-image-id="{{ media.id }}"
              aria-label="{{ 'products.product.view_image' | t: number: forloop.index | escape }}"
              aria-pressed="{% if media.id == active_image_id %}true{% else %}false{% endif %}"
            >
              {{ media.preview_image | image_url: width: 180 | image_tag: loading: 'lazy', alt: media.alt | default: product.title }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <dialog class="product-lightbox" data-product-lightbox aria-label="{{ 'products.product.image_viewer' | t }}">
        <button class="product-lightbox__close" type="button" data-lightbox-close aria-label="{{ 'products.product.close_image' | t }}">&times;</button>
        <button class="product-lightbox__step product-lightbox__step--previous" type="button" data-gallery-step="-1" aria-label="{{ 'products.product.previous_image' | t }}">&#8592;</button>
        <img
          class="product-lightbox__image"
          data-lightbox-image
          src="{{ active_media.preview_image | image_url: width: 1800 }}"
          width="{{ active_media.preview_image.width | default: 1200 }}"
          height="{{ active_media.preview_image.height | default: 1500 }}"
          alt="{{ active_media.alt | default: product.title | escape }}"
        >
        <button class="product-lightbox__step product-lightbox__step--next" type="button" data-gallery-step="1" aria-label="{{ 'products.product.next_image' | t }}">&#8594;</button>
        <span class="product-lightbox__count" data-lightbox-count></span>
      </dialog>
    </div>

    <div class="product-details">
      <div class="product-details__inner">
        <h1 class="product-title" tabindex="-1">{{ product.title | escape }}</h1>

        <div class="product-price" aria-live="polite">
          <span data-product-price>{% if has_selected_variant %}{{ current_variant.price | money }}{% else %}{{ product.price_min | money }}{% endif %}</span>
          <s data-product-compare-price{% unless has_selected_variant and current_variant.compare_at_price > current_variant.price %} hidden{% endunless %}>{{ current_variant.compare_at_price | money }}</s>
          <span class="product-price__badge" data-sale-badge{% unless has_selected_variant and current_variant.compare_at_price > current_variant.price %} hidden{% endunless %}>{{ 'products.product.sale' | t }}</span>
        </div>

        {%- if related_color_products != blank -%}
          <div class="product-colors">
            <p class="product-colors__label">
              <span>{{ 'products.product.color' | t }}</span> - 
              <span class="product-colors__label_fw" data-current-color>{{ product.metafields.custom.colour_name.value | default: product.title | escape }}</span>
            </p>
            <div class="product-colors__swatches" role="group" aria-label="{{ 'products.product.color' | t }}">
              {%- assign family_includes_current_product = false -%}
              {%- for color_product in related_color_products -%}
                {%- if color_product.id == product.id -%}
                  {%- assign family_includes_current_product = true -%}
                {%- endif -%}
                {% render 'product-color-swatch', color_product: color_product, current_product: product, has_selected_variant: has_selected_variant, selected_size: selected_size, show_swatch_label: true %}
              {%- endfor -%}
              {%- unless family_includes_current_product -%}
                {% render 'product-color-swatch', color_product: product, current_product: product, has_selected_variant: has_selected_variant, selected_size: selected_size, show_swatch_label: true %}
              {%- endunless -%}
            </div>
            <p class="product-color-status" data-color-status role="status" aria-live="polite" hidden></p>
          </div>
        {%- endif -%}

        {%- form 'product', product, id: product_form_id, class: 'product-form', data-product-form: '', data-money-format: shop.money_format, data-currency: cart.currency.iso_code, data-price-min: product.price_min -%}
          <input type="hidden" name="id" value="{% if has_selected_variant %}{{ current_variant.id }}{% endif %}" data-variant-id>
          <script type="application/json" data-product-variant-json>{{ product.variants | json }}</script>

          {%- unless product.has_only_default_variant -%}
            <div class="product-options">
              {%- for option in product.options_with_values -%}
                {%- assign option_index = forloop.index0 -%}
                {%- assign option_name = option.name | downcase -%}
                {%- assign option_style = 'size' -%}
                {%- if option_name contains 'color' or option_name contains 'colour' -%}
                  {%- assign option_style = 'color' -%}
                {%- endif -%}

                <fieldset class="product-option product-option--{{ option_style }}" data-option-group data-option-index="{{ option_index }}" data-option-name="{{ option.name | escape }}" data-option-style="{{ option_style }}" data-option-required="{% if option.values.size > 1 %}true{% else %}false{% endif %}">
                  <legend class="product-option__legend">
                    <span>{{ option.name | escape }}</span>
                    <span class="product-option__selected" data-option-selected>{% if has_selected_variant %}{{ current_variant.options[option_index] | escape }}{% elsif option_name contains 'size' %}{{ option.values.first | escape }}{% elsif option.values.size == 1 %}{{ option.values.first | escape }}{% else %}{{ 'products.product.choose_option' | t }}{% endif %}</span>
                  </legend>
                  <div class="product-option__choices">
                    {%- if option_style == 'size' -%}
                      {%- assign selected_size_label = option.values.first -%}
                      {%- if has_selected_variant -%}
                        {%- assign selected_size_label = current_variant.options[option_index] -%}
                      {%- endif -%}
                      <div class="product-option__dropdown" data-size-dropdown data-size-dropdown-open="false">
                        <button class="product-option__dropdown-toggle" type="button" data-size-dropdown-toggle aria-expanded="false">
                          <span class="product-option__dropdown-toggle-label" data-size-dropdown-label>{{ selected_size_label | escape }}</span>
                          <span class="product-option__dropdown-toggle-icon" aria-hidden="true"></span>
                        </button>
                        <div class="product-option__dropdown-menu" data-size-dropdown-menu hidden>
                          {%- for value in option.values -%}
                            {%- assign option_variant = blank -%}
                            {%- for candidate_variant in product.variants -%}
                              {%- if candidate_variant.options[option_index] == value -%}
                                {%- assign matches_current_selection = true -%}
                                {%- for other_option in product.options_with_values -%}
                                  {%- assign other_index = forloop.index0 -%}
                                  {%- if other_index != option_index and candidate_variant.options[other_index] != current_variant.options[other_index] -%}
                                    {%- assign matches_current_selection = false -%}
                                  {%- endif -%}
                                {%- endfor -%}
                                {%- if matches_current_selection -%}
                                  {%- assign option_variant = candidate_variant -%}
                                  {%- break -%}
                                {%- endif -%}
                              {%- endif -%}
                            {%- endfor -%}
                            {%- if option_variant == blank -%}
                              {%- for candidate_variant in product.variants -%}
                                {%- if candidate_variant.options[option_index] == value -%}
                                  {%- assign option_variant = candidate_variant -%}
                                  {%- break -%}
                                {%- endif -%}
                              {%- endfor -%}
                            {%- endif -%}
                            {%- capture option_label -%}{{ value | escape }}{%- if option_variant != blank -%} - {{ option_variant.price | money }}{%- endif -%}{%- endcapture -%}
                            <label class="product-option__dropdown-item{% if has_selected_variant and current_variant.options[option_index] == value %} is-selected{% elsif option_name contains 'size' and option.values.first == value %} is-selected{% endif %}" data-size-dropdown-item>
                              <input
                                type="radio"
                                name="options[{{ option.name | escape }}]"
                                value="{{ value | escape }}"
                                data-option-input
                                data-option-index="{{ option_index }}"
                                {% if has_selected_variant %}
                                  {% if current_variant.options[option_index] == value %}checked{% endif %}
                                {% elsif option_name contains 'size' %}
                                  {% if option.values.first == value %}checked{% endif %}
                                {% elsif option.values.size == 1 %}
                                  {% if option.values.first == value %}checked{% endif %}
                                {% endif %}
                              >
                              <span class="product-option__dropdown-item-label" data-size-dropdown-item-label>{{ option_label }}</span>
                            </label>
                          {%- endfor -%}
                        </div>
                      </div>
                    {%- else -%}
                      {%- for value in option.values -%}
                        {%- assign swatch_image = blank -%}
                        {%- if option_style == 'color' -%}
                          {%- for variant in product.variants -%}
                            {%- if variant.options[option_index] == value and variant.featured_media != blank -%}
                              {%- assign swatch_image = variant.featured_media.preview_image -%}
                              {%- break -%}
                            {%- endif -%}
                          {%- endfor -%}
                        {%- endif -%}
                        <label class="product-option__choice{% if option_style == 'color' %} product-option__choice--swatch{% endif %}">
                          <input
                            type="radio"
                            name="options[{{ option.name | escape }}]"
                            value="{{ value | escape }}"
                            data-option-input
                            data-option-index="{{ option_index }}"
                            {% if has_selected_variant %}
                              {% if current_variant.options[option_index] == value %}checked{% endif %}
                            {% elsif option_name contains 'size' %}
                              {% if option.values.first == value %}checked{% endif %}
                            {% elsif option.values.size == 1 %}
                              {% if option.values.first == value %}checked{% endif %}
                            {% endif %}
                          >
                          {%- if option_style == 'color' -%}
                            <span class="product-option__swatch" aria-hidden="true">
                              {%- if swatch_image != blank -%}
                                {{ swatch_image | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}
                              {%- else -%}
                                <span>{{ value | slice: 0 }}</span>
                              {%- endif -%}
                            </span>
                            <span class="product-option__color-name">{{ value | escape }}</span>
                          {%- else -%}
                            <span class="product-option__size">{{ value | escape }}</span>
                          {%- endif -%}
                        </label>
                      {%- endfor -%}
                    {%- endif -%}
                  </div>
                </fieldset>
              {%- endfor -%}
            </div>
          {%- endunless -%}

          {%- if section.settings.size_chart_page != blank -%}
            <a class="product-size-chart" href="{{ section.settings.size_chart_page.url }}">{{ 'products.product.size_chart' | t }} <span aria-hidden="true">↗</span></a>
          {%- endif -%}

          <p class="product-stock" data-product-stock aria-live="polite">
            {%- unless has_selected_variant -%}
              {%- if has_size_option -%}
                {{ 'products.product.choose_size' | t }}
              {%- else -%}
                {{ 'products.product.choose_option' | t }}
              {%- endif -%}
            {%- else -%}
            {%- if current_variant.available -%}
              {%- if current_variant.inventory_management and current_variant.inventory_quantity > 0 and current_variant.inventory_quantity <= 3 -%}
                {{ 'products.product.only_left' | t: count: current_variant.inventory_quantity }}
              {%- else -%}
                {{ 'products.product.in_stock' | t }}
              {%- endif -%}
            {%- else -%}
              {{ 'products.product.sold_out' | t }}
            {%- endif -%}
            {%- endunless -%}
          </p>
         
          <div class="product-purchase">
            <div class="product-quantity">
              <label class="product-quantity__label" for="ProductQuantity-{{ section.id }}">{{ 'products.product.quantity' | t }}</label>
              <div class="product-quantity__controls">
                <button type="button" data-quantity-change="-1" aria-label="{{ 'products.product.decrease_quantity' | t }}">−</button>
                <input id="ProductQuantity-{{ section.id }}" type="number" name="quantity" min="1" value="1" inputmode="numeric">
                <button type="button" data-quantity-change="1" aria-label="{{ 'products.product.increase_quantity' | t }}">+</button>
              </div>
            </div>
            <button class="product-add" type="submit" name="add" data-add-button{% unless has_selected_variant and current_variant.available %} disabled{% endunless %}>
              <span data-add-label>{% if current_variant.available %}{{ 'products.product.add_to_cart' | t }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}</span>
            </button>
          </div>
          <p class="product-form-error" data-form-error role="alert" hidden>{{ 'products.product.select_available_variant' | t }}</p>
          {% if form.errors %}<div class="product-form-error" role="alert">{{ form.errors | default_errors }}</div>{% endif %}
          <div class="product-payment-terms">{{ form | payment_terms }}</div>

          <div class="product-tabs" data-product-tabs>
            <div class="product-tabs__nav" role="tablist" aria-label="{{ 'products.product.tabs_label' | t }}">
              <button class="product-tabs__button is-active" type="button" role="tab" aria-selected="true" aria-controls="ProductTabDescription-{{ section.id }}" id="ProductTabButtonDescription-{{ section.id }}" data-product-tab-button="description">{{ 'products.product.tab_description' | t }}</button>
              <button class="product-tabs__button" type="button" role="tab" aria-selected="false" aria-controls="ProductTabKeyDetails-{{ section.id }}" id="ProductTabButtonKeyDetails-{{ section.id }}" data-product-tab-button="key_details">{{ 'products.product.tab_key_details' | t }}</button>
              <button class="product-tabs__button" type="button" role="tab" aria-selected="false" aria-controls="ProductTabDelivery-{{ section.id }}" id="ProductTabButtonDelivery-{{ section.id }}" data-product-tab-button="delivery">{{ 'products.product.tab_delivery' | t }}</button>
            </div>

            <div class="product-tabs__panels">
              <div class="product-tabs__panel is-active" role="tabpanel" tabindex="0" aria-labelledby="ProductTabButtonDescription-{{ section.id }}" id="ProductTabDescription-{{ section.id }}" data-product-tab-panel="description">
                {%- if product.description != blank -%}
                  <div class="product-description rte">{{ product.description }}</div>
                {%- endif -%}
              </div>

              <div class="product-tabs__panel" role="tabpanel" tabindex="0" aria-labelledby="ProductTabButtonKeyDetails-{{ section.id }}" id="ProductTabKeyDetails-{{ section.id }}" data-product-tab-panel="key_details" hidden>
                {%- if section.settings.key_details != blank -%}
                  {%- capture key_details_markup -%}{{ section.settings.key_details | escape | newline_to_br }}{%- endcapture -%}
                  {%- assign key_details_items = key_details_markup | split: '<br />' -%}
                  <div class="product-tabs__content">
                    <ul class="product-tabs__list">
                      {%- for item in key_details_items -%}
                        {%- assign key_detail_item = item | strip -%}
                        {%- if key_detail_item != blank -%}
                          <li>{{ key_detail_item }}</li>
                        {%- endif -%}
                      {%- endfor -%}
                    </ul>
                  </div>
                {%- endif -%}
              </div>

              <div class="product-tabs__panel" role="tabpanel" tabindex="0" aria-labelledby="ProductTabButtonDelivery-{{ section.id }}" id="ProductTabDelivery-{{ section.id }}" data-product-tab-panel="delivery" hidden>
                {%- if section.settings.shipping_note != blank -%}
                  <div class="product-tabs__content rte">{{ section.settings.shipping_note | escape | newline_to_br }}</div>
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- endform -%}

      </div>
    </div>
  </div>
</product-details>

<script src="{{ 'product-gallery-swipe.js' | asset_url }}" defer="defer"></script>

{% stylesheet %}
  .product-page {
    --product-ink: #20211e;
    --product-muted: #777971;
    --product-line: #d8d9d2;
    --product-surface: #f5f5f1;
    --product-accent: #efcc38;
    width: 100%;
    padding-block: 18px 0;
    color: var(--product-ink);
  }

  .product-breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-block-end: 22px;
    color: var(--product-muted);
    font-size: 11px;
  }

  .product-breadcrumbs a:hover,
  .product-size-chart:hover,
  .product-accordion-content a:hover {
    color: var(--product-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .product-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(350px, 0.8fr);
    align-items: start;
    gap: clamp(32px, 5vw, 76px);
  }

  .product-gallery {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 12px;
    min-width: 0;
  }

  .product-gallery__thumbnails {
    display: flex;
    gap: 9px;
    min-width: 0;
    overflow-x: auto;
    padding: 2px 2px 7px;
    scrollbar-width: thin;
    scroll-snap-type: x mandatory;
  }

  .product-gallery__thumbnail {
    flex: 0 0 auto;
    width: 62px;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    padding: 0;
    border: 1px solid transparent;
    background: var(--product-surface);
    cursor: pointer;
    scroll-snap-align: start;
  }

  .product-gallery__thumbnail.is-active {
    border-color: transparent;
    border-bottom: 2px solid var(--product-ink);
  }

  .product-gallery__thumbnail img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product-gallery__stage {
    position: relative;
    height: min(58vh, 680px);
    min-height: 340px;
    min-width: 0;
    background: #fff;
  }

  .product-gallery__image,
  .product-gallery__placeholder {
    width: 100%;
    height: 100%;
    aspect-ratio: auto;
  }

  .product-gallery__image[hidden] {
    display: none;
  }

  .product-gallery__photo,
  .product-gallery__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .product-gallery__open {
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: zoom-in;
  }

  .product-gallery__image.is-active {
    animation: product-image-reveal 260ms ease both;
  }

  .product-gallery__count {
    position: absolute;
    right: 12px;
    bottom: 12px;
    padding: 5px 8px;
    background: rgb(255 255 255 / 88%);
    font-size: 10px;
  }

  .product-gallery__step {
    position: absolute;
    top: 50%;
    display: grid;
    width: 42px;
    aspect-ratio: 1;
    place-items: center;
    transform: translateY(-50%);
    border: 1px solid rgb(32 33 30 / 12%);
    border-radius: 50%;
    background: rgb(255 255 255 / 92%);
    color: var(--product-ink);
    font: inherit;
    font-size: 18px;
    cursor: pointer;
  }

  .product-gallery__step:hover {
    background: #fff;
  }

  .product-gallery__step--previous {
    left: 14px;
  }

  .product-gallery__step--next {
    right: 14px;
  }

  .product-lightbox {
    position: fixed;
    inset: 0;
    display: none;
    width: 100vw;
    max-width: none;
    height: 100vh;
    max-height: none;
    margin: 0;
    padding: 24px;
    place-items: center;
    overflow: hidden;
    border: 0;
    background: #fff;
    color: var(--product-ink);
  }

  .product-lightbox[open] {
    display: grid;
  }

  .product-lightbox::backdrop {
    background: rgb(0 0 0 / 86%);
  }

  .product-lightbox__image {
    display: block;
    width: auto;
    max-width: min(92vw, 1500px);
    height: auto;
    max-height: calc(100vh - 48px);
    object-fit: contain;
  }

