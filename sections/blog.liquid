{% comment %}
  This section is used in the blog template to render the blog page listing all
  articles within a blog.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/blog
{% endcomment %}

<section class="page-content full-width">
  <header class="page-content__header">
    <h1 class="page-content__title">{{ blog.title | escape }}</h1>
    <span class="page-content__accent" aria-hidden="true"></span>
  </header>

  {% paginate blog.articles by 5 %}
    <div class="blog-page__articles">
      {% for article in blog.articles %}
        <article class="blog-page__card">
          {% if article.image %}
            <a class="blog-page__image" href="{{ article.url }}" tabindex="-1" aria-hidden="true">
              {{ article.image | image_url: width: 1000 | image_tag: loading: 'lazy' }}
            </a>
          {% endif %}
          <div class="blog-page__card-content">
            <h2 class="blog-page__card-title">
              <a href="{{ article.url }}">{{ article.title | escape }}</a>
            </h2>
            {% assign date = article.published_at | time_tag: format: 'date' %}
            <p class="blog-page__metadata">{{ 'blog.article_metadata_html' | t: date: date, author: article.author }}</p>
            <div class="blog-page__excerpt page-content__richtext rte">{{ article.excerpt }}</div>
          </div>
        </article>
      {% endfor %}
    </div>

    {%- if paginate.pages > 1 -%}
      <div class="blog-page__pagination">{{- paginate | default_pagination -}}</div>
    {%- endif -%}
  {% endpaginate %}
</section>

{% stylesheet %}
  .blog-page__articles {
    display: grid;
    width: min(100%, 1100px);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: 24px;
    margin-inline: auto;
  }

  .blog-page__card {
    overflow: hidden;
    background: var(--color-background, #fff);
    border: 1px solid color-mix(in srgb, currentColor 12%, transparent);
    border-radius: 4px;
  }

  .blog-page__image {
    display: block;
  }

  .blog-page__image img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .blog-page__card-content {
    padding: 24px;
  }

  .blog-page__card-title {
    font-size: clamp(20px, 2vw, 24px);
    line-height: 1.3;
  }

  .blog-page__card-title a {
    color: var(--section-link, inherit);
    text-decoration: none;
  }

  .blog-page__card-title a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .blog-page__card-title a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  .blog-page__metadata {
    margin-block: 10px 16px;
    font-size: var(--font-size-base, 14px);
  }

  .blog-page__excerpt {
    font-size: max(16px, var(--font-size-base, 14px));
    line-height: 1.7;
  }

  .blog-page__pagination {
    margin-block-start: 32px;
    text-align: center;
  }
{% endstylesheet %}

{% render 'informational-page-styles' %}

{% render 'section-color-scheme', section: section %}

{% render 'section-spacing', section: section %}

{% schema %}
{
  "name": "t:general.blog",
  "settings": [
    {
      "type": "range",
      "id": "section_space_above",
      "label": "t:labels.section_space_above",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_space_below",
      "label": "t:labels.section_space_below",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    { "type": "checkbox", "id": "use_color_scheme", "label": "t:labels.use_color_scheme", "default": false },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:labels.color_scheme", "default": "scheme-1", "visible_if": "{{ section.settings.use_color_scheme }}" }
  ]
}
{% endschema %}
