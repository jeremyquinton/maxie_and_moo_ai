{% comment %}
  This section is used in the article template to render the article page, which
  displays the full content of the blog post and can optionally include a
  comments section for customers (not shown in this example).

  https://shopify.dev/docs/storefronts/themes/architecture/templates/article
{% endcomment %}

<article class="page-content full-width">
  <header class="page-content__header">
    <h1 class="page-content__title">{{ article.title | escape }}</h1>
    {% assign date = article.published_at | time_tag: format: 'date' %}
    <p class="article-page__metadata">{{ 'blog.article_metadata_html' | t: date: date, author: article.author }}</p>
    <span class="page-content__accent" aria-hidden="true"></span>
  </header>

  <div class="page-content__body">
    {% if article.image %}
      <div class="article-page__image">
        {{ article.image | image_url: width: 1200 | image_tag }}
      </div>
    {% endif %}

    <div class="page-content__richtext rte">{{ article.content }}</div>

    {% if blog.comments_enabled? %}
      <div class="article-page__comments">
        <h2>{{ 'blog.article_comments' | t }}</h2>

        <div id="comments">
          {% paginate article.comments by 10 %}
            {% for comment in article.comments %}
              <div class="article-page__comment">
                <p>{{ comment.author | escape }}</p>
                <p>{{- comment.created_at | time_tag: format: 'date' -}}</p>
                <p>{{ comment.content }}</p>
              </div>
            {% endfor %}

            {{ paginate | default_pagination: anchor: 'comments' }}
          {% endpaginate %}
        </div>

        {% form 'new_comment', article %}
          <h2>{{ 'blog.comment_form_title' | t }}</h2>

          {{ form.errors | default_errors }}

          <div>
            <label for="author">{{ 'blog.comment_form_name' | t }}</label>
            <input type="text" name="comment[author]" id="author" value="{{ form.author | escape }}" required>
          </div>

          <div>
            <label for="email">{{ 'blog.comment_form_email' | t }}</label>
            <input type="email" name="comment[email]" id="email" value="{{ form.email | escape }}" required>
          </div>

          <div>
            <label for="body">{{ 'blog.comment_form_body' | t }}</label>
            <textarea name="comment[body]" id="body" required>{{ form.body | escape }}</textarea>
          </div>

          <input type="submit" value="{{ 'blog.comment_form_submit' | t | escape }}">
        {% endform %}
      </div>
    {% endif %}
  </div>
</article>

{% stylesheet %}
  .article-page__metadata {
    margin-block-start: 12px;
    font-size: var(--font-size-base, 14px);
  }

  .article-page__image {
    margin-block-end: 32px;
  }

  .article-page__image img {
    width: 100%;
    height: auto;
  }

  .article-page__comments {
    margin-block-start: 48px;
    padding-block-start: 32px;
    border-block-start: 1px solid color-mix(in srgb, currentColor 12%, transparent);
  }

  .article-page__comments h2 {
    font-size: 1.3em;
    line-height: 1.3;
  }

  .article-page__comment,
  .article-page__comments form > * {
    margin-block-start: 16px;
  }

  .article-page__comments label {
    display: block;
    margin-block-end: 4px;
  }

  .article-page__comments :is(input:not([type='submit']), textarea) {
    width: 100%;
    padding: 10px;
    border: 1px solid currentColor;
    background: transparent;
    color: inherit;
  }

  .article-page__comments textarea {
    min-height: 120px;
  }

  .article-page__comments input[type='submit'] {
    padding: 12px 20px;
    border: 1px solid currentColor;
    background: var(--section-button, #20211e);
    color: var(--section-button-text, #fff);
    cursor: pointer;
  }
{% endstylesheet %}

{% render 'informational-page-styles' %}

{% render 'section-color-scheme', section: section %}

{% render 'section-spacing', section: section %}

{% schema %}
{
  "name": "t:general.article",
  "settings": [
    {
      "type": "range",
      "id": "section_space_above",
      "label": "t:labels.section_space_above",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_space_below",
      "label": "t:labels.section_space_below",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    { "type": "checkbox", "id": "use_color_scheme", "label": "t:labels.use_color_scheme", "default": false },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:labels.color_scheme", "default": "scheme-1", "visible_if": "{{ section.settings.use_color_scheme }}" }
  ]
}
{% endschema %}
