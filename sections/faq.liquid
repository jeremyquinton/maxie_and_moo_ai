<section class="faq-section full-width" data-section-id="{{ section.id }}" style="--faq-bg: {{ section.settings.background_color | default: 'transparent' }};">
  <div class="faq-section__inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="faq-section__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}

    <div class="faq-section__header">
      {%- if section.settings.heading != blank -%}
        <h2 class="faq-section__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <div class="faq-section__subheading rte">{{ section.settings.subheading }}</div>
      {%- endif -%}
    </div>

    <div class="faq-section__items">
      {% content_for 'blocks' %}
    </div>
  </div>
</section>

{% stylesheet %}
  .faq-section {
    width: 100%;
    padding-block: clamp(32px, 6vw, 72px);
    --faq-ink: var(--section-foreground, #20211e);
    --faq-muted: var(--section-foreground, #777971);
    color: var(--faq-ink);
    background: var(--section-background, var(--faq-bg, transparent));
  }

  .faq-section__inner {
    width: min(100%, var(--content-width));
    margin-inline: auto;
  }

  .faq-section__eyebrow {
    margin: 0 0 10px;
    color: var(--faq-muted, #777971);
    font-size: var(--font-size-base, 14px);
    font-weight: 700;
    letter-spacing: var(--letter-spacing-base, 1.3px);
    text-transform: uppercase;
  }

  .faq-section__header {
    display: block;
    margin-block-end: 26px;
  }

  .faq-section__heading {
    margin: 0;
    font-family: var(--font-primary--family);
    font-size: clamp(28px, 4vw, 44px);
    font-weight: 500;
    line-height: 1.04;
    letter-spacing: var(--letter-spacing-base, 1.3px);
  }

  .faq-section__subheading {
    max-width: 68ch;
    color: var(--section-foreground, #51534d);
    font-size: var(--font-size-base, 14px);
    line-height: 1.7;
  }

  .faq-section__subheading > :first-child {
    margin-block-start: 0;
  }

  .faq-section__subheading > :last-child {
    margin-block-end: 0;
  }

  .faq-section__items {
    display: block;
  }

  @media (min-width: 900px) {
    .faq-section__header {
      display: block;
    }
  }

{% endstylesheet %}

{% render 'section-color-scheme', section: section %}

{% schema %}
{
  "name": "FAQ",
  "blocks": [
    { "type": "faq-item" },
    { "type": "@app" }
  ],
  "max_blocks": 12,
  "settings": [
    { "type": "checkbox", "id": "use_color_scheme", "label": "t:labels.use_color_scheme", "default": false },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:labels.color_scheme", "default": "scheme-1", "visible_if": "{{ section.settings.use_color_scheme }}" },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently asked questions"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Supporting text"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color"
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        {
          "type": "faq-item"
        },
        {
          "type": "faq-item"
        },
        {
          "type": "faq-item"
        }
      ]
    }
  ]
}
{% endschema %}