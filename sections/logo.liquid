{% liquid
  assign standard_logo = section.settings.logo
  assign overlay_logo = section.settings.overlay_logo | default: standard_logo
%}

<div class="site-logo full-width" style="--site-logo-width: {{ section.settings.logo_width }}px">
  <a class="site-logo__link" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
    {%- if standard_logo != blank -%}
      {{ standard_logo | image_url: width: 1000 | image_tag: class: 'site-logo__image site-logo__image--standard', widths: '160, 240, 320, 480, 640, 800, 1000', sizes: '(max-width: 600px) 70vw, 500px', loading: 'eager', alt: shop.name }}
    {%- else -%}
      <span class="site-logo__text site-logo__image--standard">{{ shop.name | escape }}</span>
    {%- endif -%}
    {%- if overlay_logo != blank -%}
      {{ overlay_logo | image_url: width: 1000 | image_tag: class: 'site-logo__image site-logo__image--overlay', widths: '160, 240, 320, 480, 640, 800, 1000', sizes: '(max-width: 600px) 70vw, 500px', loading: 'eager', alt: '' }}
    {%- else -%}
      <span class="site-logo__text site-logo__image--overlay" aria-hidden="true">{{ shop.name | escape }}</span>
    {%- endif -%}
  </a>
</div>

{% stylesheet %}
  .site-logo {
    display: flex;
    min-height: 72px;
    justify-content: center;
    align-items: center;
    padding: 10px 16px;
  }

  .site-header-shell--overlay .site-logo,
  .site-header-shell--solid .site-logo {
    position: absolute;
    top: 100%;
    right: 0;
    left: 0;
    z-index: 42;
    height: 88px;
    min-height: 0;
    padding-block: 0;
    color: #fff;
    pointer-events: none;
  }

  .site-header-shell--solid .site-logo {
    height: 68px;
    color: #20211e;
  }

  .site-header-shell--overlay.is-sticky .site-logo,
  .site-header-shell--solid.is-sticky .site-logo {
    position: fixed;
    top: 0;
    height: 68px;
    color: #20211e;
  }

  .site-logo__link {
    display: grid;
    width: min(var(--site-logo-width), calc(100vw - 32px));
    height: 68px;
    max-width: 100%;
    max-height: 100%;
    align-items: center;
    justify-content: center;
    color: inherit;
    text-decoration: none;
    pointer-events: auto;
  }

  .site-logo__image {
    display: block;
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    object-fit: contain;
  }

  .site-logo__link > * {
    grid-area: 1 / 1;
  }

  .site-logo__image--overlay {
    visibility: hidden;
  }

  .site-header-shell--overlay:not(.is-sticky) .site-logo__image--standard {
    visibility: hidden;
  }

  .site-header-shell--overlay:not(.is-sticky) .site-logo__image--overlay {
    visibility: visible;
  }

  .site-logo__text {
    font-size: 32px;
    font-weight: 700;
    line-height: 1.1;
  }

  @media (max-width: 600px) {
    .site-logo {
      min-height: 60px;
      padding-block: 8px;
    }

    .site-logo__text {
      font-size: 26px;
    }
  }

  @media (max-width: 749px) {
    .site-header-shell--overlay .site-logo,
    .site-header-shell--solid .site-logo {
      height: 58px;
      min-height: 0;
      padding-block: 0;
    }

    .site-header-shell--overlay .site-logo__link,
    .site-header-shell--solid .site-logo__link {
      height: 56px;
    }

    .site-header-shell--overlay.is-sticky .site-logo {
      height: 58px;
    }

    .site-header-shell--solid.is-sticky .site-logo {
      height: 58px;
    }

    .site-header-shell--overlay.is-sticky .site-logo,
    .site-header-shell--solid.is-sticky .site-logo {
      background: #fff;
    }
  }
{% endstylesheet %}

{% render 'section-color-scheme', section: section %}

{% render 'section-spacing', section: section %}

{% schema %}
{
  "name": "t:general.logo",
  "settings": [
    {
      "type": "range",
      "id": "section_space_above",
      "label": "t:labels.section_space_above",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_space_below",
      "label": "t:labels.section_space_below",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    { "type": "checkbox", "id": "use_color_scheme", "label": "t:labels.use_color_scheme", "default": false },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:labels.color_scheme", "default": "scheme-1", "visible_if": "{{ section.settings.use_color_scheme }}" },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:sections.logo.settings.image.label"
    },
    {
      "type": "image_picker",
      "id": "overlay_logo",
      "label": "t:sections.logo.settings.overlay_image.label",
      "info": "t:sections.logo.settings.overlay_image.info"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "t:sections.logo.settings.width.label",
      "min": 100,
      "max": 500,
      "step": 20,
      "unit": "px",
      "default": 360
    }
  ]
}
{% endschema %}
