{% doc %}
  Renders the shared product card used in featured collections and collection grids.

  @param {product} product - The product to display
  @param {string} [heading_tag] - Heading element, defaults to h3
  @param {boolean} [show_from_price] - Show only a compact minimum price without compare-at pricing
  @param {string} [card_title] - Optional fallback when the product has no display name
  @param {boolean} [image_preview_only] - Show only the second image on hover, without gallery controls
  @param {number} [card_index] - Card position for prioritizing early images

  @example
  {% render 'product-card', product: product %}
{% enddoc %}

{% liquid
  assign preview_image = product.images[1]
  assign card_heading_tag = heading_tag | default: 'h3'
  assign display_name = product.metafields.custom.display_name.value | strip
  assign card_title = display_name | default: card_title | default: product.title
  assign primary_loading = 'lazy'
  assign preview_alt = preview_image.alt | default: product.title
  assign show_minimum_price = show_from_price
  if image_preview_only
    assign preview_alt = ''
    if product.price_varies
      assign show_minimum_price = true
    endif
    if section.index and section.index <= 2
      if card_index and card_index <= 4
        assign primary_loading = 'eager'
      endif
    endif
  endif
%}
{%- capture card_price -%}
  {%- if show_minimum_price -%}
    {%- assign minimum_price = product.price_min | money_without_trailing_zeros | remove: ' ' -%}
    {{ 'products.product.price_from' | t: price: minimum_price }}
  {%- elsif product.price_varies -%}
    {{ product.price_min | money }} – {{ product.price_max | money }}
  {%- else -%}
    {{ product.price | money }}
  {%- endif -%}
{%- endcapture -%}
{%- unless image_preview_only -%}
  {%- capture card_gallery_json -%}
    [
      {%- for image in product.images -%}
        {"src":{{ image | image_url: width: 900 | json }},"alt":{{ image.alt | default: product.title | json }}}{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  {%- endcapture -%}
{%- endunless -%}
<article class="featured-collection__card"{% unless image_preview_only %} data-product-card{% endunless %}>
  <div class="featured-collection__media" data-card-gallery-container>
    <a class="featured-collection__image{% if preview_image != blank %} has-preview{% endif %}" href="{{ product.url }}" data-card-main-link>
      {%- if product.featured_image != blank -%}
        {{ product.featured_image | image_url: width: 900 | image_tag: class: 'featured-collection__image-primary', widths: '300, 450, 600, 750, 900', sizes: '(min-width: 750px) 25vw, 50vw', loading: primary_loading, alt: product.featured_image.alt | default: product.title }}
        {%- if preview_image != blank -%}
          {{ preview_image | image_url: width: 900 | image_tag: class: 'featured-collection__image-alternate', widths: '300, 450, 600, 750, 900', sizes: '(min-width: 750px) 25vw, 50vw', loading: 'lazy', alt: preview_alt }}
        {%- endif -%}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'featured-collection__placeholder' }}
      {%- endif -%}
      <span class="featured-collection__placeholder-fallback" data-card-placeholder hidden>{{ 'product-1' | placeholder_svg_tag: 'featured-collection__placeholder' }}</span>
      <span class="featured-collection__badges" data-sale-label="{{ 'products.product.sale' | t | escape }}" data-sold-out-label="{{ 'products.product.sold_out' | t | escape }}">
        {%- if product.available == false -%}
          <span class="featured-collection__badge">{{ 'products.product.sold_out' | t }}</span>
        {%- elsif product.compare_at_price_min > product.price_min -%}
          <span class="featured-collection__badge featured-collection__badge--sale">
            {%- if image_preview_only and product.has_only_default_variant -%}
              {%- assign variant = product.selected_or_first_available_variant -%}
              {%- assign discount = variant.compare_at_price | minus: variant.price | times: 100.0 | divided_by: variant.compare_at_price | round -%}
              {{- 'products.product.percent_off' | t: percent: discount -}}
            {%- else -%}
              {{- 'products.product.sale' | t -}}
            {%- endif -%}
          </span>
        {%- endif -%}
      </span>
    </a>
    {%- unless image_preview_only -%}
      <script type="application/json" data-card-gallery-data>{{ card_gallery_json }}</script>
      <div class="featured-collection__gallery-controls" data-card-gallery-controls{% if product.images.size < 2 %} hidden{% endif %}>
        <button type="button" data-card-gallery-step="-1" aria-label="{{ 'products.product.previous_image' | t }}">&#8592;</button>
        <button type="button" data-card-gallery-step="1" aria-label="{{ 'products.product.next_image' | t }}">&#8594;</button>
      </div>
    {%- endunless -%}
  </div>
  <div class="featured-collection__meta">
    <div class="featured-collection__details">
      <{{ card_heading_tag }} class="section-heading--secondary"><a href="{{ product.url }}" data-card-title-link>{{ card_title | escape }}</a></{{ card_heading_tag }}>
      <p class="featured-collection__price">
        <span data-card-displayed-price>{{ card_price | strip }}</span>
        {% if image_preview_only %}
          {% assign variant = product.selected_or_first_available_variant %}
          {% if product.has_only_default_variant and variant.compare_at_price > variant.price %}
            <s>{{ variant.compare_at_price | money }}</s>
          {% endif %}
        {% else %}
          {% unless show_from_price %}
            <s data-card-displayed-compare-price{% unless product.compare_at_price_min > product.price_min %} hidden{% endunless %}>{{ product.compare_at_price_min | money }}</s>
          {% endunless %}
        {% endif %}
      </p>
    </div>
  </div>
</article>

{% stylesheet %}
  .featured-collection__card {
    min-width: 0;
    scroll-snap-align: start;
  }

  .featured-collection__media {
    position: relative;
  }

  .featured-collection__image {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 1 / 1;
    background: #f5f5f1;
  }

  .featured-collection__image img,
  .featured-collection__placeholder {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .featured-collection__image-alternate {
    opacity: 0;
    transition: opacity 220ms ease;
  }

  .featured-collection__card.is-gallery-browsing .featured-collection__image-alternate {
    opacity: 0;
  }

  .featured-collection__gallery-controls {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-inline: 0;
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
    transition: opacity 160ms ease;
  }

  .featured-collection__gallery-controls[hidden] {
    display: none;
  }

  .featured-collection__media:hover .featured-collection__gallery-controls,
  .featured-collection__media:focus-within .featured-collection__gallery-controls {
    opacity: 1;
    visibility: visible;
  }

  .featured-collection__gallery-controls button {
    display: grid;
    width: 40px;
    height: 40px;
    place-items: center;
    border: 1px solid rgb(32 33 30 / 16%);
    border-radius: 50%;
    background: rgb(255 255 255 / 84%);
    color: #5c5c5c;
    font: inherit;
    font-size: 17px;
    cursor: pointer;
    pointer-events: auto;
    box-shadow: 0 1px 5px rgb(0 0 0 / 12%);
  }

  .featured-collection__gallery-controls button:hover {
    background: #fff;
    color: #20211e;
  }

  .featured-collection__placeholder-fallback {
    position: absolute;
    inset: 0;
  }

  .featured-collection__placeholder-fallback[hidden] {
    display: none;
  }

  .featured-collection__badges {
    position: absolute;
    top: 10px;
    left: 10px;
    display: flex;
    gap: 6px;
  }

  .featured-collection__badge {
    padding: 5px 8px;
    background: #fff;
    color: #20211e;
    font-size: var(--font-size-base, 14px);
    font-weight: 600;
    text-transform: uppercase;
  }

  .featured-collection__badge--sale {
    background: #efcc38;
  }

  .featured-collection__meta {
    display: grid;
    gap: 9px;
    padding-block-start: 11px;
  }

  .featured-collection__details {
    display: flex;
    align-items: flex-start;
    flex-direction: column;
    gap: 3px;
    font-size: var(--font-size-base, 14px);
  }

  .featured-collection__details h2,
  .featured-collection__details h3 {
    min-width: 0;
    margin: 0;
    font-size: var(--font-size-base, 14px);
    font-weight: 500;
    line-height: 1.4;
  }

  .featured-collection__details a,
  .featured-collection__details a:visited {
    color: inherit;
    text-decoration: none;
  }

  .featured-collection__details a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .featured-collection__price {
    flex: 0 0 auto;
  }

  .featured-collection__price s {
    display: block;
    color: var(--section-foreground, #777971);
    font-size: var(--font-size-base, 14px);
  }

  @media (hover: hover) and (pointer: fine) {
    .featured-collection__card:not(.is-gallery-browsing) .featured-collection__image.has-preview:hover .featured-collection__image-alternate,
    .featured-collection__card:not(.is-gallery-browsing) .featured-collection__image.has-preview:focus-visible .featured-collection__image-alternate {
      opacity: 1;
    }
  }

  @media (max-width: 700px) {
    .featured-collection__gallery-controls {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .featured-collection__image-alternate,
    .featured-collection__gallery-controls {
      transition: none;
    }
  }
{% endstylesheet %}