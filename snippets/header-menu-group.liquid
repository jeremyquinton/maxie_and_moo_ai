{% doc %}
  Renders the desktop header label with up to three ordered menu columns.

  @param {string} label - The clickable header label
  @param {object} menu_1 - The first menu column
  @param {object} menu_2 - The second menu column
  @param {object} menu_3 - The third menu column
{% enddoc %}

<details class="header__menu-item header__menu-group" data-menu-dropdown>
  <summary class="header__menu-trigger">
    {{ label | escape }}
    <span class="header__menu-chevron" aria-hidden="true"></span>
  </summary>
  <div class="header__submenu">
    <div class="header__submenu-columns">
      {%- for menu_slot in (1..3) -%}
        {% liquid
          assign column_menu = blank
          case menu_slot
            when 1
              assign column_menu = menu_1
            when 2
              assign column_menu = menu_2
            when 3
              assign column_menu = menu_3
          endcase
        %}
        {% if column_menu != blank %}
            {% assign column_menu_title = column_menu.title | replace: '&nbsp;', '' | strip %}
            {% if column_menu_title == blank %}
              {% assign column_menu_title = 'sections.header.menu_column_fallback' | t: number: menu_slot %}
            {% endif %}
          <div class="header__submenu-column">
              <h2 class="header__submenu-column-heading">{{ column_menu_title | escape }}</h2>
            <ul class="header__submenu-list">
              {% for menu_link in column_menu.links %}
                <li>
                  <a href="{{ menu_link.url | escape }}">{{ menu_link.title | escape }}</a>
                  {% if menu_link.links != blank %}
                    <ul class="header__submenu-list header__submenu-list--nested">
                      {% for child_link in menu_link.links %}
                        <li><a href="{{ child_link.url | escape }}">{{ child_link.title | escape }}</a></li>
                      {% endfor %}
                    </ul>
                  {% endif %}
                </li>
              {% endfor %}
            </ul>
          </div>
        {% endif %}
      {%- endfor -%}
    </div>
  </div>
</details>