{% doc %}
  Renders the header menu names and their mobile navigation panels.

  @param {object} menu_1 - The first menu
  @param {object} menu_2 - The second menu
  @param {object} menu_3 - The third menu
  @param {object} menu_4 - The first menu in the second group
  @param {object} menu_5 - The second menu in the second group
  @param {object} menu_6 - The third menu in the second group
  @param {string} label_1 - The first group label
  @param {string} label_2 - The second group label
  @param {boolean} show_first_group - Whether the first group is configured
  @param {boolean} show_second_group - Whether the second group is configured
  @param {string} section_id - The header section ID
{% enddoc %}

<ul class="header__mobile-list" data-menu-root aria-hidden="false">
  {%- for menu_slot in (1..6) -%}
    {% if menu_slot == 1 and show_first_group and show_second_group %}
      <li><h2 class="header__mobile-group-heading">{{ label_1 | escape }}</h2></li>
    {% endif %}
    {% if menu_slot == 4 and show_second_group %}
      <li><h2 class="header__mobile-group-heading">{{ label_2 | escape }}</h2></li>
    {% endif %}
    {% liquid
      assign column_menu = ''
      assign column_number = menu_slot | minus: 1 | modulo: 3 | plus: 1
      case menu_slot
        when 1
          if show_first_group
            assign column_menu = menu_1
          endif
        when 2
          if show_first_group
            assign column_menu = menu_2
          endif
        when 3
          if show_first_group
            assign column_menu = menu_3
          endif
        when 4
          if show_second_group
            assign column_menu = menu_4
          endif
        when 5
          if show_second_group
            assign column_menu = menu_5
          endif
        when 6
          if show_second_group
            assign column_menu = menu_6
          endif
      endcase
    %}
    {% if column_menu != blank %}
      {% assign column_menu_title = column_menu.title | replace: '&nbsp;', '' | strip %}
      {% if column_menu_title == blank %}
        {% assign column_menu_title = 'sections.header.menu_column_fallback' | t: number: column_number %}
      {% endif %}
      <li class="header__mobile-item">
        <button
          class="header__mobile-open"
          type="button"
          aria-label="{{ 'sections.header.show_links' | t: title: column_menu_title | escape }}"
          aria-expanded="false"
          aria-controls="MobileMenuPanel-{{ section_id }}-column-{{ menu_slot }}"
          data-menu-open
          data-panel-id="MobileMenuPanel-{{ section_id }}-column-{{ menu_slot }}"
          data-panel-title="{{ column_menu_title | escape }}"
        >
          <span>{{ column_menu_title | escape }}</span>
          <span class="header__mobile-chevron" aria-hidden="true"></span>
        </button>
      </li>
    {% endif %}
  {%- endfor -%}
</ul>

{%- for menu_slot in (1..6) -%}
  {% liquid
    assign column_menu = ''
    case menu_slot
      when 1
        if show_first_group
          assign column_menu = menu_1
        endif
      when 2
        if show_first_group
          assign column_menu = menu_2
        endif
      when 3
        if show_first_group
          assign column_menu = menu_3
        endif
      when 4
        if show_second_group
          assign column_menu = menu_4
        endif
      when 5
        if show_second_group
          assign column_menu = menu_5
        endif
      when 6
        if show_second_group
          assign column_menu = menu_6
        endif
    endcase
  %}
  {% if column_menu != blank %}
    <div class="header__mobile-list" id="MobileMenuPanel-{{ section_id }}-column-{{ menu_slot }}" data-menu-panel aria-hidden="true" inert>
      <ul class="header__mobile-column-list">
        {%- for menu_link in column_menu.links -%}
          <li>
            {% if menu_link.links != blank %}
              <details class="header__mobile-submenu">
                <summary>
                  {{ menu_link.title | escape }}
                  <span class="header__mobile-chevron" aria-hidden="true"></span>
                </summary>
                <ul>
                  <li><a href="{{ menu_link.url | escape }}">{{ 'sections.header.shop_all' | t: title: menu_link.title | escape }}</a></li>
                  {% for child_link in menu_link.links %}
                    <li><a href="{{ child_link.url | escape }}">{{ child_link.title | escape }}</a></li>
                  {% endfor %}
                </ul>
              </details>
            {% else %}
              <a class="header__mobile-link" href="{{ menu_link.url | escape }}">{{ menu_link.title | escape }}</a>
            {% endif %}
          </li>
        {%- endfor -%}
      </ul>
    </div>
  {% endif %}
{%- endfor -%}