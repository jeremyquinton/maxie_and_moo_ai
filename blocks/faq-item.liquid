{% doc %}
  Renders a single FAQ accordion item.

  @example
  {% content_for 'block', type: 'faq-item', id: 'faq-item' %}
{% enddoc %}

<details class="faq-item{% if block.settings.open_by_default %} is-open{% endif %}"{% if block.settings.open_by_default %} open{% endif %} {{ block.shopify_attributes }}>
  <summary class="faq-item__question">
    <span>{{ block.settings.question | escape }}</span>
    <span class="faq-item__icon" aria-hidden="true"></span>
  </summary>

  {%- if block.settings.answer != blank -%}
    <div class="faq-item__answer rte">
      {{ block.settings.answer }}
    </div>
  {%- endif -%}
</details>

{% stylesheet %}
  .faq-item {
    border-bottom: 1px solid var(--faq-line, #d8d9d2);
  }

  .faq-item:first-child {
    border-top: 1px solid var(--faq-line, #d8d9d2);
  }

  .faq-item__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: 20px 0;
    list-style: none;
    cursor: pointer;
  }

  .faq-item__question::-webkit-details-marker {
    display: none;
  }

  .faq-item__question span:first-child {
    color: var(--faq-ink, #20211e);
    font-size: 15px;
    font-weight: 600;
    line-height: 1.4;
  }

  .faq-item__icon {
    position: relative;
    flex: 0 0 14px;
    width: 14px;
    height: 14px;
  }

  .faq-item__icon::before,
  .faq-item__icon::after {
    content: '';
    position: absolute;
    inset: 50% auto auto 0;
    width: 14px;
    height: 1.5px;
    background: currentColor;
    transform: translateY(-50%);
  }

  .faq-item__icon::after {
    transform: translateY(-50%) rotate(90deg);
    transition: transform 160ms ease;
  }

  .faq-item[open] .faq-item__icon::after {
    transform: translateY(-50%) rotate(180deg);
  }

  .faq-item__answer {
    padding: 0 0 20px;
    color: #51534d;
    font-size: 13px;
    line-height: 1.75;
  }

  .faq-item__answer > :first-child {
    margin-block-start: 0;
  }

  .faq-item__answer > :last-child {
    margin-block-end: 0;
  }

  @media (max-width: 680px) {
    .faq-item__question {
      padding: 18px 0;
    }

    .faq-item__question span:first-child {
      font-size: 14px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "FAQ item",
  "settings": [
    {
      "type": "text",
      "id": "question",
      "label": "Question",
      "default": "Question"
    },
    {
      "type": "richtext",
      "id": "answer",
      "label": "Answer"
    },
    {
      "type": "checkbox",
      "id": "open_by_default",
      "label": "Open by default",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "FAQ item"
    }
  ]
}
{% endschema %}