{% doc %}
  Displays available products from a selected collection as color swatches.
{% enddoc %}

{% liquid
  assign color_collection = block.settings.collection
  assign product_collection_handles = product.collections | map: 'handle'
  assign current_variant = product.selected_variant | default: product.selected_or_first_available_variant | default: product.variants.first
  assign selected_size = blank
  assign has_selected_variant = true

  unless product.has_only_default_variant or product.selected_variant != blank
    assign has_selected_variant = false
  endunless

  for option in product.options_with_values
    assign option_name = option.name | downcase
    if option_name contains 'size'
      if has_selected_variant
        assign selected_size = current_variant.options[forloop.index0]
      else
        assign selected_size = option.values.first
      endif
      break
    endif
  endfor
%}

{% if color_collection != blank %}
  {% if product_collection_handles contains color_collection.handle %}
    <div class="product-colors" {{ block.shopify_attributes }}>
      {% paginate color_collection.products by 50 %}
        {% capture color_swatches %}
          {% for color_product in color_collection.products %}
            {% if color_product.available %}
              {% render 'product-color-swatch', color_product: color_product, current_product: product, has_selected_variant: has_selected_variant, selected_size: selected_size, use_product_primary_image: true %}
            {% endif %}
          {% endfor %}
        {% endcapture %}
        {% assign color_swatches = color_swatches | strip %}
        {% if color_swatches != blank or paginate.pages > 1 %}
          <h2 class="product-colors__heading section-heading--secondary" id="ProductColorHeading-{{ block.id }}">{{ 'products.product.select_color' | t }}</h2>
          <div class="product-colors__swatches" role="group" aria-labelledby="ProductColorHeading-{{ block.id }}">
            {{ color_swatches }}
          </div>
          {% if paginate.pages > 1 %}
            <nav aria-label="{{ 'products.product.color_pages' | t | escape }}">{{ paginate | default_pagination }}</nav>
          {% endif %}
          <p class="product-color-status" data-color-status role="status" aria-live="polite" hidden></p>
        {% endif %}
      {% endpaginate %}
    </div>
  {% endif %}
{% endif %}

{% stylesheet %}
  .product-colors {
    margin-block-end: 20px;
  }

  .product-colors__heading {
    margin: 0 0 10px;
    font-size: var(--font-size-base, 14px);
    font-weight: 600;
  }

  .product-colors__swatches {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
  }

  .product-color-status {
    margin-block-start: 8px;
    color: var(--section-foreground, #777971);
    font-size: var(--font-size-base, 14px);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:blocks.product_color_picker.name",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "t:blocks.product_color_picker.settings.collection.label",
      "info": "t:blocks.product_color_picker.settings.collection.info"
    }
  ],
  "presets": [
    { "name": "t:blocks.product_color_picker.name" }
  ]
}
{% endschema %}